<Window
    x:Class="TaskTile.Popups.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TaskTile.Popups"
    mc:Ignorable="d">

    <Grid x:Name="_root" Background="Transparent" Opacity="0" VerticalAlignment="Top">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="_rootTranslate" Y="0" />
                <ScaleTransform x:Name="_rootScale" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.Resources>
            <Storyboard x:Name="_popIn">
                <DoubleAnimation Storyboard.TargetName="_root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.160">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="_rootTranslate" Storyboard.TargetProperty="Y" From="16" To="0" Duration="0:0:0.350">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <AcrylicBrush x:Key="FlyoutAcrylic" TintColor="#202020" TintOpacity="0.5" TintLuminosityOpacity="0.96" FallbackColor="#1C1C1C" />
            <LinearGradientBrush x:Key="HoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#15FFFFFF" Offset="0.0" />
                <GradientStop Color="#05FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#0BFFFFFF" />
        </Grid.Resources>

        <Border x:Name="_border" Padding="12">
            <Grid x:Name="_content">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="_title" Grid.Row="0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="0,0,0,16" TextTrimming="CharacterEllipsis" />

                <StackPanel x:Name="_holder" Grid.Row="1" HorizontalAlignment="Center">
                    <!-- Classic -->
                    <ScrollViewer x:Name="_classicSV" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="ClassicSV_PointerWheelChanged">
                        <GridView x:Name="_classicR" Margin="0" HorizontalAlignment="Center" SelectionMode="None" IsItemClickEnabled="True" ItemClick="App_ItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewItem">
                                            <Grid x:Name="RootGrid" Background="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.250" />
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="HoverBg.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                                                            </VisualState.Setters>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.150" />
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.083" />
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <!-- Razor thin ThemeResource hover -->
                                                <Border x:Name="HoverBg" Opacity="0" CornerRadius="4" BorderThickness="1" Background="{StaticResource HoverBackgroundBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                            </Grid>
                                        </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                </TransitionCollection>
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:AppEntryViewModel">
                                    <Grid Width="84" Height="84" CornerRadius="4" ToolTipService.ToolTip="{x:Bind Name}" ToolTipService.Placement="Bottom" Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Open" Tag="{x:Bind ExePath}" Click="Open_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8E5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Run as Administrator" Tag="{x:Bind ExePath}" Click="RunAdmin_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE7EF;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Open file location" Tag="{x:Bind ExePath}" Click="OpenLoc_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8DA;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Edit this Group" Click="EditGroup_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Launch All" Click="LaunchAll_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="32" Height="32">
                                                <Border Background="{x:Bind UwpBackground}" CornerRadius="6" />
                                                <Image Width="32" Height="32" Stretch="Uniform" Source="{x:Bind IconImage, Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" LineHeight="14" Foreground="#D7FFFFFF" Text="{x:Bind Name}" Visibility="{x:Bind LabelVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>

                    <!-- Compact -->
                    <ListView x:Name="_compactR" Margin="4" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="App_ItemClick" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True"/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AppEntryViewModel">
                                <Grid Width="80" Height="80" Background="{x:Bind UwpBackground}" CornerRadius="{x:Bind TileCornerRadius}" ToolTipService.ToolTip="{x:Bind Name}" ToolTipService.Placement="Bottom">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Run as Administrator" Tag="{x:Bind ExePath}" Click="RunAdmin_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7EF;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open File Location" Tag="{x:Bind ExePath}" Click="OpenLoc_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Image Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Modern -->
                    <ScrollViewer x:Name="_modernSV" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <GridView x:Name="_modernR" Margin="6" SelectionMode="None" IsItemClickEnabled="True" ItemClick="App_ItemClick">
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                </TransitionCollection>
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:AppEntryViewModel">
                                    <Grid Width="60" Height="60" Background="{x:Bind UwpBackground}" CornerRadius="12" ToolTipService.ToolTip="{x:Bind Name}" ToolTipService.Placement="Bottom">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Run as Administrator" Tag="{x:Bind ExePath}" Click="RunAdmin_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7EF;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Open File Location" Tag="{x:Bind ExePath}" Click="OpenLoc_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Image Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>

                    <!-- List -->
                    <ScrollViewer x:Name="_listSV" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <ListView x:Name="_listR" Margin="6,4,6,4" SelectionMode="None" IsItemClickEnabled="True" ItemClick="App_ItemClick">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AppEntryViewModel">
                                    <Grid HorizontalAlignment="Stretch" Height="36" Padding="8,0,8,0" Background="Transparent" CornerRadius="6">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Run as Administrator" Tag="{x:Bind ExePath}" Click="RunAdmin_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7EF;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Open File Location" Tag="{x:Bind ExePath}" Click="OpenLoc_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Grid Width="20" Height="20" VerticalAlignment="Center" CornerRadius="4" Background="{x:Bind UwpBackground}">
                                                <Image Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock FontSize="13" VerticalAlignment="Center" Foreground="#EBFFFFFF" TextTrimming="CharacterEllipsis" Text="{x:Bind Name}" Visibility="{x:Bind LabelVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                    <!-- Card -->
                    <!-- Card -->
                    <Grid x:Name="_cardContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <GridView x:Name="_cardR" Margin="12,12,12,12" SelectionMode="None" IsItemClickEnabled="True" ItemClick="App_ItemClick">
                                <GridView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                    </TransitionCollection>
                                </GridView.ItemContainerTransitions>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:AppEntryViewModel">
                                        <Grid Width="64" Height="64" Margin="2" CornerRadius="8" Background="Transparent" ToolTipService.ToolTip="{x:Bind Name}">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Open" Tag="{x:Bind ExePath}" Click="Open_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE737;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Run as Administrator" Tag="{x:Bind ExePath}" Click="RunAdmin_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7EF;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open File Location" Tag="{x:Bind ExePath}" Click="OpenLoc_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Edit this Group" Click="EditGroup_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Launch All" Click="LaunchAll_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                                <Image Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" />
                                                <TextBlock FontSize="10" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Name}" Visibility="{x:Bind LabelVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </ScrollViewer>
                        
                        <!-- Bottom Bar -->
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="_cardFooterName" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Style="{ThemeResource AlternateCloseButtonStyle}" Background="Transparent" Click="EditGroup_Click" Padding="4" Height="28" Width="28" ToolTipService.ToolTip="Edit group">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="_pageDots" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2" Margin="0,0,2,0" Visibility="Collapsed" Background="Transparent" Padding="4" PointerEntered="PageDots_PointerEntered" PointerExited="PageDots_PointerExited" />
    </Grid>
</Window>
