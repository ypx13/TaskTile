<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskTile.Controls.GroupCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTile.Controls">

    <UserControl.Resources>
        <Flyout x:Name="SettingsFlyout" Placement="Bottom">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <Grid x:Name="MiniSettingsRoot" Width="335" MaxHeight="450"
                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mini Settings Header -->
                <Grid Grid.Row="0" Padding="14,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="QuickSettingsTitleText" Text="Group Settings" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseMiniSettingsBtn"
                            Click="CloseMiniSettingsBtn_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            ToolTipService.ToolTip="Close settings">
                        <FontIcon Glyph="&#xE711;" FontSize="11"/>
                    </Button>
                </Grid>

                <!-- Mini Settings Scrollable Options (Native Fluent 2 Card Rows) -->
                <ScrollViewer Grid.Row="1" Padding="12,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <!-- Standard Groups Panel (Apps / Files) -->
                        <Border x:Name="StandardQuickSettingsPanel"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                            <StackPanel>
                                <!-- Setting 1: Popup Style -->
                                <Grid Padding="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Style" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Popup layout" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="PopupStyleCombo" Grid.Column="2" SelectionChanged="SettingChanged" Width="126" VerticalAlignment="Center">
                                        <x:String>Classic</x:String>
                                        <x:String>Compact</x:String>
                                        <x:String>Modern</x:String>
                                        <x:String>List</x:String>
                                        <x:String>Large</x:String>
                                    </ComboBox>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/>

                                <!-- Setting 2: Backdrop Material -->
                                <Grid Padding="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE771;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Backdrop" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Material blur" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="PopupBackdropCombo" Grid.Column="2" SelectionChanged="SettingChanged" Width="126" VerticalAlignment="Center">
                                        <x:String>Acrylic</x:String>
                                        <x:String>Mica</x:String>
                                        <x:String>Mica Alt</x:String>
                                        <x:String>Solid</x:String>
                                    </ComboBox>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/>

                                <!-- Setting 3: Theme -->
                                <Grid Padding="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE793;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Popup color mode" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="PopupThemeCombo" Grid.Column="2" SelectionChanged="SettingChanged" Width="126" VerticalAlignment="Center">
                                        <x:String>Auto (System)</x:String>
                                        <x:String>Light</x:String>
                                        <x:String>Dark</x:String>
                                    </ComboBox>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/>

                                <!-- Setting 4: Hide Group Name -->
                                <Grid Padding="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Hide group name" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="HideNameToggle" Grid.Column="2" OnContent="" OffContent="" Toggled="SettingChanged" HorizontalAlignment="Right" MinWidth="0" Margin="0,-4,0,-4"/>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/>

                                <!-- Setting 5: Hide App Labels -->
                                <Grid Padding="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE890;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Hide app labels" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="HideAppLabelsToggle" Grid.Column="2" OnContent="" OffContent="" Toggled="SettingChanged" HorizontalAlignment="Right" MinWidth="0" Margin="0,-4,0,-4"/>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/>

                                <!-- Setting 6: Taskbar Gap -->
                                <Grid Padding="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE740;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Taskbar Gap" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Offset from taskbar" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Slider x:Name="MiniTaskbarGapSlider" Grid.Column="2" Width="100" Minimum="0" Maximum="48" StepFrequency="1"
                                            VerticalAlignment="Center" ValueChanged="MiniTaskbarGapSlider_ValueChanged"/>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/>

                                <!-- Setting 7: Title Alignment -->
                                <Grid Padding="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8E3;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Title Alignment" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Left, Center, or Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Slider x:Name="MiniTitleAlignmentSlider" Grid.Column="2" Width="100" Minimum="0" Maximum="2" StepFrequency="1" TickFrequency="1" TickPlacement="Outside"
                                            VerticalAlignment="Center" ValueChanged="MiniTitleAlignmentSlider_ValueChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Radial Menu Settings Panel -->
                        <StackPanel x:Name="RadialQuickSettingsPanel" Spacing="8" Visibility="Collapsed">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEE94;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Radial pie menu orbiting your cursor" FontSize="12" TextWrapping="WrapWholeWords" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="RadialShortcutBox" Header="Trigger Shortcut" PlaceholderText="e.g. Ctrl+Shift+A" TextChanged="RadialShortcutBox_TextChanged"/>

                            <Button x:Name="TestRadialBtn" HorizontalAlignment="Stretch" Click="TestRadialBtn_Click" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEE94;" FontSize="12"/>
                                    <TextBlock Text="Test Radial Menu at Cursor" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mini Settings Footer with Fullscreen Expand Button -->
                <Grid Grid.Row="2" Padding="12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Button x:Name="FullscreenSettingsBtn"
                            Click="FullscreenSettingsBtn_Click"
                            HorizontalAlignment="Stretch"
                            Padding="12,8"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            ToolTipService.ToolTip="More settings">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE740;" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Fullscreen Settings" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Flyout>
    </UserControl.Resources>

    <!-- Padding grid gives the card breathing room -->
    <Grid Padding="2">
        <Border
            x:Name="CardBorder"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CanDrag="False"
            AllowDrop="True"
            PointerEntered="CardBorder_PointerEntered"
            PointerPressed="CardBorder_PointerPressed"
            PointerReleased="CardBorder_PointerReleased"
            PointerCanceled="CardBorder_PointerCanceled"
            PointerMoved="CardBorder_PointerMoved"
            DragStarting="CardBorder_DragStarting"
            DragOver="CardBorder_DragOver"
            Drop="CardBorder_Drop">

            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="RenameMenuItem" Text="Rename Group" Click="RenameContext_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete Group" Click="DeleteButton_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid>
                <!-- Default (Classic) Card Layout (Horizontal) -->
                <Grid x:Name="DefaultLayoutRoot" RowSpacing="12" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Icon on Left, Text on Right -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Preview: Polished Fluent 2 rounded container -->
                        <Grid Grid.Column="0" Width="48" Height="48" CornerRadius="10" Margin="0,0,14,0"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1">
                            <!-- Placeholder grid icon if no apps -->
                            <FontIcon x:Name="PlaceholderIcon" Glyph="&#xF168;" FontSize="22"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <Image x:Name="GroupIconImage" Stretch="Uniform" Margin="4" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Name + app count: Inline rename support -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="GroupNameText"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"
                                       PointerPressed="GroupNameText_PointerPressed"
                                       ToolTipService.ToolTip="Click or right-click to rename"/>
                            <TextBox x:Name="GroupNameEditBox"
                                     Visibility="Collapsed"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     Padding="6,3"
                                     MinHeight="30"
                                     BorderThickness="0,0,0,2"
                                     CornerRadius="4,4,0,0"
                                     PointerPressed="EditBox_PointerPressed"
                                     KeyDown="GroupNameEditBox_KeyDown"
                                     LostFocus="GroupNameEditBox_LostFocus"/>
                            <TextBlock x:Name="AppCountText"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Action Buttons -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PinButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Click="PinButton_Click"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="8,0"
                                Height="32">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="13"/>
                                <TextBlock x:Name="PinText" Text="Pin"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="8,0,0,0">
                            <Button x:Name="SettingsButton"
                                    Padding="0" Width="32" Height="32"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Click="SettingsButton_Click"
                                    ToolTipService.ToolTip="Group settings">
                                <FontIcon Glyph="&#xE713;" FontSize="13"/>
                            </Button>

                            <Button x:Name="DeleteButton"
                                    Padding="0" Width="32" Height="32"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Click="DeleteButton_Click"
                                    ToolTipService.ToolTip="Delete group">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Visitor ID Card Layout (Compact Square) -->
                <Grid x:Name="VisitorIdLayoutRoot" Visibility="Collapsed" RowSpacing="10" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: App Group Icon - Centered, Prominent Square Plate -->
                    <Grid x:Name="VisitorIconPlate" Grid.Row="0" Width="112" Height="112" CornerRadius="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                        <FontIcon x:Name="VisitorPlaceholderIcon" Glyph="&#xF168;" FontSize="38"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        
                        <!-- Single App or Custom Group Icon -->
                        <Image x:Name="VisitorSingleImage" Width="60" Height="60" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                        <!-- Multiple Apps Native High-Res 2x2 Grid -->
                        <Grid x:Name="VisitorGridIcons" Margin="8" ColumnSpacing="6" RowSpacing="6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image x:Name="VisitorIcon0" Grid.Row="0" Grid.Column="0" Width="36" Height="36" Stretch="Uniform"/>
                            <Image x:Name="VisitorIcon1" Grid.Row="0" Grid.Column="1" Width="36" Height="36" Stretch="Uniform"/>
                            <Image x:Name="VisitorIcon2" Grid.Row="1" Grid.Column="0" Width="36" Height="36" Stretch="Uniform"/>
                            <Image x:Name="VisitorIcon3" Grid.Row="1" Grid.Column="1" Width="36" Height="36" Stretch="Uniform"/>
                        </Grid>
                    </Grid>

                    <!-- Row 1: App Group name • app count -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="VisitorGroupNameText"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="140"
                                   VerticalAlignment="Center"
                                   PointerPressed="VisitorGroupNameText_PointerPressed"
                                   ToolTipService.ToolTip="Click or right-click to rename"/>
                        <TextBox x:Name="VisitorGroupNameEditBox"
                                 Visibility="Collapsed"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Padding="4,2"
                                 MinHeight="26"
                                 BorderThickness="0,0,0,2"
                                 CornerRadius="4,4,0,0"
                                 PointerPressed="EditBox_PointerPressed"
                                 KeyDown="VisitorGroupNameEditBox_KeyDown"
                                 LostFocus="VisitorGroupNameEditBox_LostFocus"/>
                        <TextBlock Text="•" Margin="6,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VisitorAppCountText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 2: Action Buttons -->
                    <Grid Grid.Row="2" ColumnSpacing="6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="VisitorPinButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Click="PinButton_Click"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="6,0"
                                Height="32">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon x:Name="VisitorPinIcon" Glyph="&#xE718;" FontSize="12"/>
                                <TextBlock x:Name="VisitorPinText" Text="Pin"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="VisitorSettingsButton"
                                Grid.Column="1"
                                Padding="0" Width="32" Height="32"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Click="SettingsButton_Click"
                                ToolTipService.ToolTip="Group settings">
                            <FontIcon Glyph="&#xE713;" FontSize="12"/>
                        </Button>

                        <Button x:Name="VisitorDeleteButton"
                                Grid.Column="2"
                                Padding="0" Width="32" Height="32"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Click="DeleteButton_Click"
                                ToolTipService.ToolTip="Delete group">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Super Compact Card Layout (One-Line Row / Lines) -->
                <Grid x:Name="SuperCompactLayoutRoot" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Compact Icon Plate -->
                    <Grid x:Name="SuperCompactIconPlate" Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          VerticalAlignment="Center" Margin="0,0,12,0">
                        <FontIcon x:Name="SuperCompactPlaceholderIcon" Glyph="&#xF168;" FontSize="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <Image x:Name="SuperCompactSingleImage" Width="20" Height="20" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Grid x:Name="SuperCompactGridIcons" Margin="2" ColumnSpacing="2" RowSpacing="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image x:Name="SuperCompactIcon0" Grid.Row="0" Grid.Column="0" Width="10" Height="10" Stretch="Uniform"/>
                            <Image x:Name="SuperCompactIcon1" Grid.Row="0" Grid.Column="1" Width="10" Height="10" Stretch="Uniform"/>
                            <Image x:Name="SuperCompactIcon2" Grid.Row="1" Grid.Column="0" Width="10" Height="10" Stretch="Uniform"/>
                            <Image x:Name="SuperCompactIcon3" Grid.Row="1" Grid.Column="1" Width="10" Height="10" Stretch="Uniform"/>
                        </Grid>
                    </Grid>

                    <!-- Column 1: Name and Apps count in one line -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SuperCompactGroupNameText"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320"
                                   VerticalAlignment="Center"
                                   PointerPressed="SuperCompactGroupNameText_PointerPressed"
                                   ToolTipService.ToolTip="Click or right-click to rename"/>
                        <TextBox x:Name="SuperCompactGroupNameEditBox"
                                 Visibility="Collapsed"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Padding="4,2"
                                 MinHeight="26"
                                 BorderThickness="0,0,0,2"
                                 CornerRadius="4,4,0,0"
                                 PointerPressed="EditBox_PointerPressed"
                                 KeyDown="SuperCompactGroupNameEditBox_KeyDown"
                                 LostFocus="SuperCompactGroupNameEditBox_LostFocus"/>
                        <TextBlock Text="•" Margin="8,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SuperCompactAppCountText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Column 2: Action Buttons in one line on the right -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0">
                        <Button x:Name="SuperCompactPinButton"
                                Click="PinButton_Click"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="10,0"
                                Height="30">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon x:Name="SuperCompactPinIcon" Glyph="&#xE718;" FontSize="11"/>
                                <TextBlock x:Name="SuperCompactPinText" Text="Pin"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SuperCompactSettingsButton"
                                Padding="0" Width="30" Height="30"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Click="SettingsButton_Click"
                                ToolTipService.ToolTip="Group settings">
                            <FontIcon Glyph="&#xE713;" FontSize="12"/>
                        </Button>

                        <Button x:Name="SuperCompactDeleteButton"
                                Padding="0" Width="30" Height="30"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Click="DeleteButton_Click"
                                ToolTipService.ToolTip="Delete group">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
