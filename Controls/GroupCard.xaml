<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskTile.Controls.GroupCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTile.Controls">

    <!-- Padding grid gives the card breathing room so hover state doesn't clip -->
    <Grid Padding="2">
    <Border
        x:Name="CardBorder"
        VerticalAlignment="Top"
        HorizontalAlignment="Stretch"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Padding="16,16,16,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <!-- Gradient elevation border — matches WinUI buttons/Start Menu hover -->
                        <Setter Target="CardBorder.BorderBrush"
                                Value="{ThemeResource ControlElevationBorderBrush}"/>
                        <Setter Target="CardBorder.BorderThickness" Value="1"/>
                    </VisualState.Setters>
                    <VisualState.Storyboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder"
                                                           Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0"
                                    Value="{ThemeResource ControlElevationBorderBrush}"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState.Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>


        <Border.Resources>
            <Storyboard x:Name="HoverIn">
                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity"
                                 To="0.85" Duration="0:0:0.15"/>
            </Storyboard>
            <Storyboard x:Name="HoverOut">
                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity"
                                 To="1.0" Duration="0:0:0.12"/>
            </Storyboard>

        </Border.Resources>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Icon on Left, Text on Right -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Large Icon Preview -->
                <Grid Grid.Column="0" Width="68" Height="68" CornerRadius="{ThemeResource ControlCornerRadius}" Margin="0,0,16,0">
                    <Grid.Background>
                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.12"/>
                    </Grid.Background>
                    <!-- Placeholder grid icon if no apps -->
                    <FontIcon x:Name="PlaceholderIcon" Glyph="&#xF168;" FontSize="28"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <Image x:Name="GroupIconImage" Stretch="Uniform" Visibility="Collapsed" Margin="6"/>
                </Grid>

                <!-- Name + app count -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="GroupNameText"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AppCountText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Action Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PinButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Click="PinButton_Click"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="8,4"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="14"/>
                        <TextBlock x:Name="PinText" Text="Desktop Shortcut"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="8,0,0,0">
                    <Button x:Name="SettingsButton"
                            Padding="0" Width="36" Height="36"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            ToolTipService.ToolTip="Group settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <Button.Flyout>
                            <Flyout>
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                        <Setter Property="MaxWidth" Value="800" />
                                        <Setter Property="MinWidth" Value="400" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600" Padding="0,0,16,0">
                                    <StackPanel Spacing="16" Margin="0,12,0,0">
                                        <TextBlock Text="Group Settings" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="PopupStyleCombo" Header="Layout style" SelectionChanged="SettingChanged" HorizontalAlignment="Stretch" PlaceholderText="Select layout">
                                            <x:String>Classic Grid</x:String>
                                            <x:String>Compact (Row/Column)</x:String>
                                            <x:String>Modern</x:String>
                                            <x:String>List</x:String>
                                            <x:String>Dialog-ish</x:String>
                                        </ComboBox>

                                         <ToggleSwitch x:Name="HideNameToggle" Header="Hide popup title" Toggled="SettingChanged"/>
                                         <ToggleSwitch x:Name="HideAppLabelsToggle" Header="Hide app labels" Toggled="SettingChanged"/>
                                         <ToggleSwitch x:Name="MarqueeAppLabelsToggle" Header="Marquee long app labels (List)" Toggled="SettingChanged" ToolTipService.ToolTip="Continuously marquees long app names in List layout"/>
                                         <ToggleSwitch x:Name="ScrollAppLabelsToggle" Header="Scroll long app labels (List)" Toggled="SettingChanged" ToolTipService.ToolTip="Allows horizontally scrolling long app names in List layout"/>
                                         <ToggleSwitch x:Name="ShowCardLabelsToggle" Header="Show app labels (Not recommended)" Toggled="SettingChanged" Visibility="Collapsed" ToolTipService.ToolTip="Shows labels in the Dialog-ish layout"/>
                                        
                                        <StackPanel x:Name="LaunchAtCenterPanel" Spacing="0">
                                            <ToggleSwitch x:Name="OverrideLaunchSideToggle" Header="Override launch position" Toggled="SettingChanged"/>
                                            <ComboBox x:Name="LaunchPositionCombo" Header="Launch Position" SelectionChanged="SettingChanged" Margin="16,8,0,8" Visibility="Collapsed" Width="160">
                                                <ComboBoxItem Content="Top"/>
                                                <ComboBoxItem Content="Bottom"/>
                                                <ComboBoxItem>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Left"/>
                                                        <TextBlock Text="🧪" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Right"/>
                                                        <TextBlock Text="🧪" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Content="Center"/>
                                            </ComboBox>
                                            <ToggleSwitch x:Name="MakeMainFocusToggle" Header="Make main focus" Toggled="SettingChanged" Margin="0,0,0,0"
                                                            Visibility="Collapsed"
                                                            ToolTipService.ToolTip="Dims and blurs desktop behind group popup. Click anywhere outside to close."/>
                                        </StackPanel>
                                        
                                        <ToggleSwitch x:Name="DisableAnimationToggle" Header="Disable entrance animation" Toggled="SettingChanged" Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Disables sliding and fading animations for pop-ups."/>
                                        <ToggleSwitch x:Name="DisableFloatToggle" Header="Disable float" Toggled="SettingChanged" Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Makes the bottom corners sharp and removes the gap between the taskbar and the app group."/>
                                        <ToggleSwitch x:Name="DisableRoundedCornersToggle" Header="Disable rounded corners" Toggled="SettingChanged" Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Makes the app group corners sharp and removes the border, making it look like Windows 10."/>
                                        <ToggleSwitch x:Name="DisableAutoHideToggle" Header="Disable auto-hide support" Toggled="SettingChanged" Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Prevents pop-ups from closing automatically when losing focus."/>
                                        <ToggleSwitch x:Name="KeepOpenToggle" Header="Disable lose focus" Toggled="SettingChanged" Margin="0,0,0,0"/>

                                        <ToggleSwitch x:Name="DesktopModeToggle" Header="Adaptive desktop mode" Toggled="SettingChanged"
                                                      ToolTipService.ToolTip="Offset popup based on cursor position instead of taskbar, and use fade animation."/>
                                        
                                        <ComboBox x:Name="PopupBackdropCombo" Header="Folder style (Popup backdrop)" SelectionChanged="SettingChanged" HorizontalAlignment="Stretch" PlaceholderText="Select backdrop">
                                            <x:String>Acrylic</x:String>
                                            <x:String>Mica (Default)</x:String>
                                            <x:String>Mica Alt</x:String>
                                            <x:String>None (Solid)</x:String>
                                        </ComboBox>

                                        <!-- Border color override hidden for now -->
                                        <ToggleSwitch x:Name="OverrideBorderColorToggle" Header="Override border color" Toggled="SettingChanged" Margin="0,8,0,0" Visibility="Collapsed"/>
                                        <Button x:Name="BorderColorButton" Content="Choose border color" Visibility="Collapsed" Margin="0,0,0,12">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel>
                                                        <ColorPicker x:Name="CustomBorderColorPicker"
                                                              ColorSpectrumShape="Box"
                                                              IsMoreButtonVisible="True"
                                                              IsColorSliderVisible="True"
                                                              IsColorChannelTextInputVisible="True"
                                                              IsHexInputVisible="True"
                                                              IsAlphaEnabled="False"
                                                              IsAlphaSliderVisible="True"
                                                              IsAlphaTextInputVisible="True" 
                                                              ColorChanged="CustomBorderColorPicker_ColorChanged" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <ComboBox x:Name="FolderIconStyleCombo" Header="Folder Icon Style (Taskbar)" SelectionChanged="SettingChanged" HorizontalAlignment="Stretch" PlaceholderText="Select style">
                                            <x:String>Normal (Dark)</x:String>
                                            <x:String>Transparent</x:String>
                                            <x:String>UWP Style</x:String>
                                        </ComboBox>
                                        
                                        <ComboBox x:Name="AlignmentCombo" Header="Horizontal or Vertical settings" SelectionChanged="SettingChanged" HorizontalAlignment="Stretch" Visibility="Collapsed">
                                            <x:String>Horizontal (Row)</x:String>
                                            <x:String>Vertical (Column)</x:String>
                                        </ComboBox>
                                        
                                        <ToggleSwitch x:Name="MonochromeFolderIconToggle" Header="Monochrome folder icon" Toggled="SettingChanged"/>
                                        
                                        <Button x:Name="CustomIconButton" Content="Choose custom icon for folder" HorizontalAlignment="Stretch" Click="CustomIconButton_Click"/>
                                        <Button x:Name="ClearCustomIconButton" Content="Reset custom icon" HorizontalAlignment="Stretch" Click="ClearCustomIconButton_Click" Visibility="Collapsed"/>
                                        
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                                        
                                        <TextBlock Text="App Icon Overrides" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                        
                                        <ComboBox x:Name="AppIconStyleCombo" Header="App icons style" SelectionChanged="SettingChanged" HorizontalAlignment="Stretch" PlaceholderText="Select icon style">
                                            <x:String>Transparent (Default)</x:String>
                                            <x:String>Monochrome</x:String>
                                            <x:String>UWP Background</x:String>
                                            <x:String>One-Tone</x:String>
                                        </ComboBox>
                                        
                                        <ComboBox x:Name="ThemeOverrideCombo" Header="Theme override" SelectionChanged="SettingChanged" HorizontalAlignment="Stretch" PlaceholderText="Select theme">
                                            <x:String>Global default</x:String>
                                            <x:String>Light</x:String>
                                            <x:String>Dark</x:String>
                                        </ComboBox>

                                        <StackPanel x:Name="TitleAlignmentPanel" Spacing="4">
                                            <TextBlock Text="Title alignment (0=Left, 1=Center, 2=Right)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Slider x:Name="TitleAlignmentSlider" Minimum="-1" Maximum="2" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" ValueChanged="SettingChanged" />
                                            <TextBlock Text="(Set to -1 to use Global Settings)" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GridSettingsPanel" Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <NumberBox x:Name="ColumnsBox" Header="Columns (0=Auto)" Minimum="0" Maximum="10" ValueChanged="NumberBox_ValueChanged" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox x:Name="RowsBox" Grid.Column="2" Header="Rows (0=Auto)" Minimum="0" Maximum="10" ValueChanged="NumberBox_ValueChanged" SpinButtonPlacementMode="Compact"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="DeleteButton"
                            Padding="0" Width="36" Height="36"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Click="DeleteButton_Click"
                            ToolTipService.ToolTip="Delete group">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    </Grid>
</UserControl>


