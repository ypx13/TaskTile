<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TaskTile.Controls.CreateGroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="{ThemeResource OverlayCornerRadius}">

    <StackPanel Spacing="16" Width="480">

        // title
        <TextBlock x:Name="DialogTitleText"
                   Text="Create Group"
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   FontWeight="SemiBold"
                   FontSize="20"
                   Margin="0,0,0,0"/>

        // thye input
        <StackPanel Spacing="6">
            <TextBlock x:Name="GroupNameHeader" Text="Group name" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            <TextBox
                x:Name="GroupNameBox"
                PlaceholderText="e.g. Work, Gaming, Creative…"
                MaxLength="64"
                CornerRadius="{ThemeResource ControlCornerRadius}"/>
        </StackPanel>

        <!-- App picker -->
        <StackPanel Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Add apps" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedCountText"
                           Grid.Column="1"
                           Text="0 selected"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Search box -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Search apps…"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    TextChanged="SearchBox_TextChanged">
                    <TextBox.Description>Start typing to filter installed apps</TextBox.Description>
                </TextBox>
                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="Browse for File…"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="BrowseButton_Click"
                    VerticalAlignment="Top"
                    Margin="12,0,0,0"/>
            </Grid>

            <!-- Loading state -->
            <ProgressRing x:Name="LoadingRing" IsActive="True" Visibility="Visible" HorizontalAlignment="Center" Margin="0,12"/>

            
            <ListView
                x:Name="AppListView"
                Height="270"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="AppListView_ItemClick"
                Visibility="Collapsed"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,5" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Native Fluent 2 WinUI 3 CheckBox -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      IsHitTestVisible="False"
                                      MinWidth="0"
                                      Padding="0"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>

                            
                            <Border Grid.Column="1" Width="20" Height="20"
                                    Margin="0,0,10,0"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsIconVisible}">
                                <Image Width="20" Height="20" Source="{Binding IconPath}" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                    
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ExePath}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsPathVisible}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

     
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CreateButton" Grid.Column="0" Content="Create"
                    HorizontalAlignment="Stretch" Margin="0,0,6,0"
                    Style="{ThemeResource AccentButtonStyle}" CornerRadius="{ThemeResource ControlCornerRadius}"
                    Click="CreateButton_Click"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel"
                    HorizontalAlignment="Stretch" Margin="6,0,0,0"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Click="CancelButton_Click"/>
        </Grid>

    </StackPanel>
</ContentDialog>
