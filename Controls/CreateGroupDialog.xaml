<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TaskTile.Controls.CreateGroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Group"
    MinWidth="480"
    CornerRadius="{ThemeResource OverlayCornerRadius}">

    <!-- Removed native ContentDialog buttons because they can glitch and touch/lose corners.
         Using custom buttons at the bottom instead for 100% control over layout and radii. -->

    <StackPanel Spacing="16" Width="440">

        <!-- Group name input -->
        <StackPanel Spacing="6">
            <TextBlock Text="Group name" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            <TextBox
                x:Name="GroupNameBox"
                PlaceholderText="e.g. Work, Gaming, Creative…"
                MaxLength="64"
                CornerRadius="{ThemeResource ControlCornerRadius}"/>
        </StackPanel>

        <!-- App picker -->
        <StackPanel Spacing="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Add apps" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedCountText"
                           Grid.Column="1"
                           Text="0 selected"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Search box -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Search apps…"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    TextChanged="SearchBox_TextChanged">
                    <TextBox.Description>Start typing to filter installed apps</TextBox.Description>
                </TextBox>
                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="Browse for File…"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="BrowseButton_Click"
                    VerticalAlignment="Top"
                    Margin="12,0,0,0"/>
            </Grid>

            <!-- Loading state -->
            <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Center" Margin="0,8"/>

            <!-- App list -->
            <ListView
                x:Name="AppListView"
                MaxHeight="260"
                SelectionMode="Multiple"
                Visibility="Collapsed"
                SelectionChanged="AppListView_SelectionChanged"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="24" Height="24"
                                   Source="{Binding IconPath}" Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Custom Buttons -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CreateButton" Grid.Column="0" Content="Create"
                    HorizontalAlignment="Stretch" Margin="0,0,8,0"
                    Style="{ThemeResource AccentButtonStyle}" CornerRadius="{ThemeResource ControlCornerRadius}"
                    Click="CreateButton_Click"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel"
                    HorizontalAlignment="Stretch" Margin="8,0,0,0"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Click="CancelButton_Click"/>
        </Grid>

    </StackPanel>
</ContentDialog>
