<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskTile.Pages.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaskTile.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="28,28,28,16" Spacing="4">
            <TextBlock Text="Groups" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock
                Text="Create and manage your app groups."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"/>
        </StackPanel>

        <!-- Groups grid and Empty state -->
        <Grid Grid.Row="1" Margin="28,4,28,100">

            <!-- Empty state -->
            <StackPanel x:ConnectionId='3' x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xF168;" FontSize="48"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="No groups yet"
                           HorizontalAlignment="Center"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Click the + button below to create your first group."
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Style="{ThemeResource BodyTextBlockStyle}"/>
            </StackPanel>

            <!-- ItemsRepeater with LinedFlowLayout (layout set in code-behind) -->
            <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:ConnectionId='4' x:Name="GroupsItemsView">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:GroupCard GroupData="{Binding}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

        </Grid>

        <!-- Floating + button -->
        <Button x:ConnectionId='2'
            x:Name="AddGroupButton"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,28,32"
            Width="52" Height="52"
            CornerRadius="8"
                                        
            Style="{ThemeResource AccentButtonStyle}"
            ToolTipService.ToolTip="Create new group">
            <FontIcon Glyph="&#xE710;" FontSize="20"/>
        </Button>

    </Grid>
</Page>

