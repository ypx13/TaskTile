<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskTile.Controls.GroupCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTile.Controls">

    <!-- Padding grid gives the card breathing room so hover state doesn't clip -->
    <Grid Padding="2">
    <Border x:ConnectionId='2'
        x:Name="CardBorder"
        VerticalAlignment="Top"
        HorizontalAlignment="Stretch"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Padding="16,16,16,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
                                            
                                          >

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:ConnectionId='3' x:Name="CommonStates">
                <VisualState x:ConnectionId='4' x:Name="Normal"/>
                <VisualState x:ConnectionId='5' x:Name="PointerOver">
                    <VisualState.Setters>
                        <!-- Gradient elevation border — matches WinUI buttons/Start Menu hover -->
                        <Setter Target="CardBorder.BorderBrush"
                                Value="{ThemeResource ControlElevationBorderBrush}"/>
                        <Setter Target="CardBorder.BorderThickness" Value="1"/>
                    </VisualState.Setters>
                    <VisualState.Storyboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBorder"
                                                           Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0"
                                    Value="{ThemeResource ControlElevationBorderBrush}"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState.Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>


        <Border.Resources>
            <Storyboard x:ConnectionId='6' x:Name="HoverIn">
                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity"
                                 To="0.85" Duration="0:0:0.15"/>
            </Storyboard>
            <Storyboard x:ConnectionId='7' x:Name="HoverOut">
                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity"
                                 To="1.0" Duration="0:0:0.12"/>
            </Storyboard>

        </Border.Resources>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Icon on Left, Text on Right -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Large Icon Preview -->
                <Grid Grid.Column="0" Width="68" Height="68" CornerRadius="{ThemeResource ControlCornerRadius}" Margin="0,0,16,0">
                    <Grid.Background>
                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.12"/>
                    </Grid.Background>
                    <!-- Placeholder grid icon if no apps -->
                    <FontIcon x:ConnectionId='45' x:Name="PlaceholderIcon" Glyph="&#xF168;" FontSize="28"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <Image x:ConnectionId='46' x:Name="GroupIconImage" Stretch="Uniform" Visibility="Collapsed" Margin="6"/>
                </Grid>

                <!-- Name + app count -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='43' x:Name="GroupNameText"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:ConnectionId='44' x:Name="AppCountText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Action Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:ConnectionId='8' x:Name="PinButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                                               
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="8,4"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon x:ConnectionId='41' x:Name="PinIcon" Glyph="&#xE718;" FontSize="14"/>
                        <TextBlock x:ConnectionId='42' x:Name="PinText" Text="Desktop Shortcut"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="8,0,0,0">
                    <Button x:ConnectionId='9' x:Name="SettingsButton"
                            Padding="0" Width="36" Height="36"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            ToolTipService.ToolTip="Group settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600" Padding="0,0,16,0">
                                    <StackPanel Spacing="16" Width="500" Margin="0,12,0,0">
                                        <TextBlock Text="Group Settings" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8"/>
                                        <ComboBox x:ConnectionId='11' x:Name="PopupStyleCombo" Header="Layout style"                                   HorizontalAlignment="Stretch" PlaceholderText="Select layout">
                                            <x:String>Classic Grid</x:String>
                                            <x:String>Compact (Row/Column)</x:String>
                                            <x:String>Modern</x:String>
                                            <x:String>List</x:String>
                                            <x:String>Dialog-ish</x:String>
                                        </ComboBox>

                                        <ToggleSwitch x:ConnectionId='12' x:Name="HideNameToggle" Header="Hide popup title"                         />
                                        <ToggleSwitch x:ConnectionId='13' x:Name="HideAppLabelsToggle" Header="Hide app labels"                         />
                                        <ToggleSwitch x:ConnectionId='14' x:Name="ShowCardLabelsToggle" Header="Show app labels (Not recommended)"                          Visibility="Collapsed" ToolTipService.ToolTip="Shows labels in the Dialog-ish layout"/>
                                        
                                        <StackPanel x:ConnectionId='15' x:Name="LaunchAtCenterPanel" Spacing="0">
                                            <ToggleSwitch x:ConnectionId='38' x:Name="OverrideLaunchSideToggle" Header="Override launch position"                         />
                                            <ComboBox x:ConnectionId='39' x:Name="LaunchPositionCombo" Header="Launch Position"                                   Margin="16,8,0,8" Visibility="Collapsed" Width="160">
                                                <ComboBoxItem Content="Top"/>
                                                <ComboBoxItem Content="Bottom"/>
                                                <ComboBoxItem>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Left"/>
                                                        <TextBlock Text="🧪" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Right"/>
                                                        <TextBlock Text="🧪" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Content="Center"/>
                                            </ComboBox>
                                            <ToggleSwitch x:ConnectionId='40' x:Name="MakeMainFocusToggle" Header="Make main focus"                          Margin="0,0,0,0"
                                                            Visibility="Collapsed"
                                                            ToolTipService.ToolTip="Dims and blurs desktop behind group popup. Click anywhere outside to close."/>
                                        </StackPanel>
                                        
                                        <ToggleSwitch x:ConnectionId='16' x:Name="DisableAnimationToggle" Header="Disable entrance animation"                          Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Disables sliding and fading animations for pop-ups."/>
                                        <ToggleSwitch x:ConnectionId='17' x:Name="DisableFloatToggle" Header="Disable float"                          Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Makes the bottom corners sharp and removes the gap between the taskbar and the app group."/>
                                        <ToggleSwitch x:ConnectionId='18' x:Name="DisableRoundedCornersToggle" Header="Disable rounded corners"                          Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Makes the app group corners sharp and removes the border, making it look like Windows 10."/>
                                        <ToggleSwitch x:ConnectionId='19' x:Name="DisableAutoHideToggle" Header="Disable auto-hide support"                          Margin="0,0,0,0"
                                                            ToolTipService.ToolTip="Prevents pop-ups from closing automatically when losing focus."/>
                                        <ToggleSwitch x:ConnectionId='20' x:Name="KeepOpenToggle" Header="Disable lose focus"                          Margin="0,0,0,0"/>

                                        <ToggleSwitch x:ConnectionId='21' x:Name="DesktopModeToggle" Header="Adaptive desktop mode"                         
                                                      ToolTipService.ToolTip="Offset popup based on cursor position instead of taskbar, and use fade animation."/>
                                        
                                        <ComboBox x:ConnectionId='22' x:Name="PopupBackdropCombo" Header="Folder style (Popup backdrop)"                                   HorizontalAlignment="Stretch" PlaceholderText="Select backdrop">
                                            <x:String>Acrylic</x:String>
                                            <x:String>Mica</x:String>
                                            <x:String>Mica Alt</x:String>
                                            <x:String>None</x:String>
                                        </ComboBox>

                                        <!-- Border color override hidden for now -->
                                        <ToggleSwitch x:ConnectionId='23' x:Name="OverrideBorderColorToggle" Header="Override border color"                          Margin="0,8,0,0" Visibility="Collapsed"/>
                                        <Button x:ConnectionId='24' x:Name="BorderColorButton" Content="Choose border color" Visibility="Collapsed" Margin="0,0,0,12">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel>
                                                        <ColorPicker x:ConnectionId='37' x:Name="CustomBorderColorPicker"
                                                              ColorSpectrumShape="Box"
                                                              IsMoreButtonVisible="True"
                                                              IsColorSliderVisible="True"
                                                              IsColorChannelTextInputVisible="True"
                                                              IsHexInputVisible="True"
                                                              IsAlphaEnabled="False"
                                                              IsAlphaSliderVisible="True"
                                                              IsAlphaTextInputVisible="True" 
                                                                                                                  />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <ComboBox x:ConnectionId='25' x:Name="FolderIconStyleCombo" Header="Folder Icon Style (Taskbar)"                                   HorizontalAlignment="Stretch" PlaceholderText="Select style">
                                            <x:String>Normal (Dark)</x:String>
                                            <x:String>Transparent</x:String>
                                            <x:String>UWP Style</x:String>
                                        </ComboBox>
                                        
                                        <ComboBox x:ConnectionId='26' x:Name="AlignmentCombo" Header="Horizontal or Vertical settings"                                   HorizontalAlignment="Stretch" Visibility="Collapsed">
                                            <x:String>Horizontal (Row)</x:String>
                                            <x:String>Vertical (Column)</x:String>
                                        </ComboBox>
                                        
                                        <ToggleSwitch x:ConnectionId='27' x:Name="MonochromeFolderIconToggle" Header="Monochrome folder icon"                         />
                                        
                                        <Button x:ConnectionId='28' x:Name="CustomIconButton" Content="Choose custom icon for folder" HorizontalAlignment="Stretch"                               />
                                        <Button x:ConnectionId='29' x:Name="ClearCustomIconButton" Content="Reset custom icon" HorizontalAlignment="Stretch"                                     Visibility="Collapsed"/>
                                        
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
                                        
                                        <TextBlock Text="App Icon Overrides" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                        
                                        <ComboBox x:ConnectionId='30' x:Name="AppIconStyleCombo" Header="App icons style"                                   HorizontalAlignment="Stretch" PlaceholderText="Select icon style">
                                            <x:String>Transparent (Default)</x:String>
                                            <x:String>Monochrome</x:String>
                                            <x:String>UWP Background</x:String>
                                            <x:String>One-Tone</x:String>
                                        </ComboBox>
                                        
                                        <ComboBox x:ConnectionId='31' x:Name="ThemeOverrideCombo" Header="Theme override"                                   HorizontalAlignment="Stretch" PlaceholderText="Select theme">
                                            <x:String>Global default</x:String>
                                            <x:String>Light</x:String>
                                            <x:String>Dark</x:String>
                                        </ComboBox>

                                        <StackPanel x:ConnectionId='32' x:Name="TitleAlignmentPanel" Spacing="4">
                                            <TextBlock Text="Title alignment (0=Left, 1=Center, 2=Right)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Slider x:ConnectionId='36' x:Name="TitleAlignmentSlider" Minimum="-1" Maximum="2" StepFrequency="1" TickFrequency="1" TickPlacement="Outside"                               />
                                            <TextBlock Text="(Set to -1 to use Global Settings)" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel x:ConnectionId='33' x:Name="GridSettingsPanel" Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <NumberBox x:ConnectionId='34' x:Name="ColumnsBox" Header="Columns (0=Auto)" Minimum="0" Maximum="10"                                       SpinButtonPlacementMode="Compact"/>
                                                <NumberBox x:ConnectionId='35' x:Name="RowsBox" Grid.Column="2" Header="Rows (0=Auto)" Minimum="0" Maximum="10"                                       SpinButtonPlacementMode="Compact"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:ConnectionId='10' x:Name="DeleteButton"
                            Padding="0" Width="36" Height="36"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                                      
                            ToolTipService.ToolTip="Delete group">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    </Grid>
</UserControl>



