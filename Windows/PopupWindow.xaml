                                              <Border MinWidth="16" Height="16" CornerRadius="8" Padding="4,0,4,0"
                                                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                      BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"
                                                      Visibility="{x:Bind NotificationBadgeVisibility, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind NotificationBadgeTooltip, Mode=OneWay}">
                                                  <TextBlock Text="{x:Bind NotificationBadgeText, Mode=OneWay}"
                                                             FontSize="10" FontWeight="SemiBold"
                                                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                              </Border>
                                              <!-- Admin Shield Badge (Windows UAC Shield) -->
                                              <Border Width="16" Height="16" CornerRadius="8"
                                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                      Visibility="{x:Bind AdminShieldVisibility, Mode=OneWay}"
                                                      ToolTipService.ToolTip="Always runs as administrator">
                                                  <FontIcon Glyph="&#xE7EF;" FontSize="9" Foreground="{x:Bind AdminShieldBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                              </Border>
                                          </StackPanel>
                                          <Button Click="RemoveAppBtn_Click" PointerEntered="RemoveAppBtn_PointerEntered" PointerExited="RemoveAppBtn_PointerExited" Tag="{x:Bind}" Visibility="{x:Bind EditModeVisibility, Mode=OneWay}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Padding="0" Margin="0,2,2,0"
                                                  CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlElevationBorderBrush}" ToolTipService.ToolTip="Remove from group">
                                              <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                          </Button>
                                        </Grid>
                                    </Grid>
                                 </DataTemplate>
                             </ListView.ItemTemplate>
                         </ListView>
                     </ScrollViewer>
                      <!-- Dialog-ish / Folder Popup -->
                      <Grid x:Name="_cardContainer" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                          <Grid.RowDefinitions>
                              <RowDefinition Height="*" />
                              <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Border Grid.Row="0" Background="Transparent" CornerRadius="0">
                              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                  <GridView x:Name="_cardR" ItemClick="App_ItemClick" Padding="8,6,8,6" Margin="0" SelectionMode="None" IsItemClickEnabled="True" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                  <GridView.ItemsPanel>
                                      <ItemsPanelTemplate>
                                          <ItemsWrapGrid ItemWidth="150" ItemHeight="38" Orientation="Horizontal" HorizontalAlignment="Center" />
                                      </ItemsPanelTemplate>
                                  </GridView.ItemsPanel>
                                  <GridView.ItemContainerTransitions>
                                      <TransitionCollection>
                                          <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24"/>
                                      </TransitionCollection>
                                  </GridView.ItemContainerTransitions>
                                  <GridView.ItemContainerStyle>
                                      <Style TargetType="GridViewItem">
                                          <Setter Property="Margin" Value="0"/>
                                          <Setter Property="Padding" Value="0"/>
                                          <Setter Property="MinWidth" Value="0"/>
                                          <Setter Property="MinHeight" Value="0"/>
                                          <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                          <Setter Property="VerticalAlignment" Value="Stretch"/>
                                          <Setter Property="Background" Value="Transparent"/>
                                          <Setter Property="Template">
                                              <Setter.Value>
                                                  <ControlTemplate TargetType="GridViewItem">
                                                      <Grid x:Name="RootGrid" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                          <VisualStateManager.VisualStateGroups>
                                                              <VisualStateGroup x:Name="CommonStates">
                                                                  <VisualState x:Name="Normal">
                                                                      <VisualState.Setters>
                                                                          <Setter Target="TileCard.Background" Value="Transparent" />
                                                                          <Setter Target="TileCard.BorderBrush" Value="Transparent" />
                                                                      </VisualState.Setters>
                                                                  </VisualState>
                                                                  <VisualState x:Name="PointerOver">
                                                                      <VisualState.Setters>
                                                                          <Setter Target="TileCard.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                                          <Setter Target="TileCard.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                                                                      </VisualState.Setters>
                                                                  </VisualState>
                                                                  <VisualState x:Name="Pressed">
                                                                      <VisualState.Setters>
                                                                          <Setter Target="TileCard.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                                          <Setter Target="TileCard.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                                                                      </VisualState.Setters>
                                                                  </VisualState>
                                                              </VisualStateGroup>
                                                          </VisualStateManager.VisualStateGroups>
                                                          <Border x:Name="TileCard" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1" BackgroundSizing="InnerBorderEdge" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2">
                                                              <Border.BackgroundTransition>
                                                                  <BrushTransition Duration="0:0:0.083" />
                                                              </Border.BackgroundTransition>
                                                          </Border>
                                                          <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0" Padding="0" />
                                                      </Grid>
                                                  </ControlTemplate>
                                              </Setter.Value>
                                          </Setter>
                                      </Style>
                                  </GridView.ItemContainerStyle>
                                  <GridView.ItemTemplate>
                                      <DataTemplate x:DataType="popups:AppEntryViewModel">
                                          <Grid CornerRadius="{ThemeResource ControlCornerRadius}" ToolTipService.Placement="Bottom" ToolTipService.ToolTip="{x:Bind Name}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="6,2,6,2">
                                              <Grid.ContextFlyout>
                                                  <MenuFlyout>
                                                      <MenuFlyoutItem Text="Open" Click="Open_Click" Tag="{x:Bind ExePath}">
                                                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                                      </MenuFlyoutItem>
<MenuFlyoutItem Text="Run as Administrator" Click="RunAdmin_Click" Tag="{x:Bind ExePath}">
                                                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7EF;" /></MenuFlyoutItem.Icon>
                                                      </MenuFlyoutItem>
                                                      <MenuFlyoutItem Text="Launch Options..." Click="LaunchOptions_Click" Tag="{x:Bind}">
                                                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                                      </MenuFlyoutItem>
                                                      <MenuFlyoutSeparator />
                                                      <MenuFlyoutItem Text="Open file location" Click="OpenLoc_Click" Tag="{x:Bind ExePath}">
                                                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                                                      </MenuFlyoutItem>
                                                      <MenuFlyoutSeparator />
                                                      <MenuFlyoutItem Text="Edit this Group" Click="EditGroup_Click">
                                                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                      </MenuFlyoutItem>
                                                      <MenuFlyoutItem Text="Launch All" Click="LaunchAll_Click">
                                                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                                      </MenuFlyoutItem>
                                                  </MenuFlyout>
                                              </Grid.ContextFlyout>
                                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                  <Grid Width="26" Height="28" VerticalAlignment="Center">
                                                      <Image Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Source="{x:Bind IconImage, Mode=OneWay}" />
                                                      <!-- Running Indicator (Fluent 2 Taskbar Pill) -->
                                                      <Border Width="12" Height="2" CornerRadius="1"
                                                              Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                              Margin="0,0,0,1"
                                                              Visibility="{x:Bind RunningBarVisibility, Mode=OneWay}" />
                                                       <!-- Running Indicator Dot (Corner Dot) -->
                                                       <Border Width="5" Height="5" CornerRadius="2.5" Background="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Visibility="{x:Bind RunningDotVisibility, Mode=OneWay}" />
                                                  </Grid>
                                                  <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110" Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                                              </StackPanel>

                                              <!-- Edit Mode Remove Badge -->
                                               <!-- Badges (Notification Count & Admin Shield, Top-Right) -->
                                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Spacing="3">
                                              <!-- Live Notification Badge -->
                                              <Border MinWidth="16" Height="16" CornerRadius="8" Padding="4,0,4,0"
                                                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                      BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"
                                                      Visibility="{x:Bind NotificationBadgeVisibility, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind NotificationBadgeTooltip, Mode=OneWay}">
                                                  <TextBlock Text="{x:Bind NotificationBadgeText, Mode=OneWay}"
                                                             FontSize="10" FontWeight="SemiBold"
                                                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                              </Border>
                                              <!-- Admin Shield Badge (Windows UAC Shield) -->
                                              <Border Width="16" Height="16" CornerRadius="8"
                                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                      Visibility="{x:Bind AdminShieldVisibility, Mode=OneWay}"
                                                      ToolTipService.ToolTip="Always runs as administrator">
                                                  <FontIcon Glyph="&#xE7EF;" FontSize="9" Foreground="{x:Bind AdminShieldBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                              </Border>
                                          </StackPanel>
                                          <Button Click="RemoveAppBtn_Click" PointerEntered="RemoveAppBtn_PointerEntered" PointerExited="RemoveAppBtn_PointerExited" Tag="{x:Bind}" Visibility="{x:Bind EditModeVisibility, Mode=OneWay}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Padding="0" Margin="0,2,2,0"
                                                      CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlElevationBorderBrush}" ToolTipService.ToolTip="Remove from group">
                                                  <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                              </Button>
                                          </Grid>
                                      </DataTemplate>
                                  </GridView.ItemTemplate>
                              </GridView>
                              </ScrollViewer>
                          </Border>

                          <!-- Bottom bar: subtle tinted chin stretching to the bottom edge with 14px Semibold title and Edit button -->
                          <Border x:Name="_cardFooterBorder" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="12,6,8,6" BorderThickness="0,1,0,0">
                              <Grid>
                                  <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock x:Name="_cardFooterName" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0">
                                      <TextBlock.ContextFlyout>
                                          <MenuFlyout>
                                              <MenuFlyoutItem Text="Edit app group" Click="EditGroup_Click">
                                                  <MenuFlyoutItem.Icon>
                                                      <FontIcon Glyph="&#xE70F;" />
                                                  </MenuFlyoutItem.Icon>
                                              </MenuFlyoutItem>
                                              <MenuFlyoutItem Text="Edit app group (Parent)" Click="EditGroupParent_Click">
                                                  <MenuFlyoutItem.Icon>
                                                      <FontIcon Glyph="&#xE713;" />
                                                  </MenuFlyoutItem.Icon>
                                              </MenuFlyoutItem>
                                              <MenuFlyoutSeparator />
                                              <MenuFlyoutItem Text="Rename app group" Click="RenameGroup_Click">
                                                  <MenuFlyoutItem.Icon>
                                                      <FontIcon Glyph="&#xE8AC;" />
                                                  </MenuFlyoutItem.Icon>
                                              </MenuFlyoutItem>
                                          </MenuFlyout>
                                      </TextBlock.ContextFlyout>
                                  </TextBlock>
                                  <Button x:Name="_cardEditBtn" Grid.Column="1" Click="EditGroup_Click" ToolTipService.ToolTip="Edit this Group" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                      <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  </Button>
                              </Grid>
                          </Border>
                      </Grid>
                </Grid>
            </Grid>
        </Border>

        <StackPanel x:Name="_pageDots" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2" Margin="0,0,2,0" Visibility="Collapsed" Background="Transparent" Padding="4" PointerEntered="PageDots_PointerEntered" PointerExited="PageDots_PointerExited" />
    </Grid>
</Window>








