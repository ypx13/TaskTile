<Window
    x:Class="TaskTile.Popups.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TaskTile.Popups" xmlns:popups="using:TaskTile.Popups"
    mc:Ignorable="d">

    <Grid x:Name="_root" Background="Transparent" Opacity="0" VerticalAlignment="Stretch">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="_rootTranslate" Y="0" />
                <ScaleTransform x:Name="_rootScale" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Edit App Group" Click="EditGroup_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Rename App Group" Click="RenameGroup_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="TileControlFillDefault" Color="#0FFFFFFF" />
                        <SolidColorBrush x:Key="TileControlFillSecondary" Color="#15FFFFFF" />
                        <SolidColorBrush x:Key="TileControlFillTertiary" Color="#08FFFFFF" />
                        <SolidColorBrush x:Key="TileControlStrokeDefault" Color="#14FFFFFF" />
                        <SolidColorBrush x:Key="TileControlStrokeSecondary" Color="#1AFFFFFF" />
                        <SolidColorBrush x:Key="TileElevationBorder" Color="#1AFFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="TileControlFillDefault" Color="#B3FFFFFF" />
                        <SolidColorBrush x:Key="TileControlFillSecondary" Color="#80F9F9F9" />
                        <SolidColorBrush x:Key="TileControlFillTertiary" Color="#4DF9F9F9" />
                        <SolidColorBrush x:Key="TileControlStrokeDefault" Color="#0F000000" />
                        <SolidColorBrush x:Key="TileControlStrokeSecondary" Color="#29000000" />
                        <SolidColorBrush x:Key="TileElevationBorder" Color="#29000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Storyboard x:Key="_popIn" x:Name="_popIn">
                    <DoubleAnimation x:Name="_popInOpacity" Storyboard.TargetName="_root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.130">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="_popInTranslateY" Storyboard.TargetName="_rootTranslate" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.170">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="_popInTranslateX" Storyboard.TargetName="_rootTranslate" Storyboard.TargetProperty="X" From="0" To="0" Duration="0:0:0.170">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="_popInScaleX" Storyboard.TargetName="_rootScale" Storyboard.TargetProperty="ScaleX" From="0.99" To="1" Duration="0:0:0.160">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="_popInScaleY" Storyboard.TargetName="_rootScale" Storyboard.TargetProperty="ScaleY" From="0.99" To="1" Duration="0:0:0.160">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <AcrylicBrush x:Key="FlyoutAcrylic" TintColor="#202020" TintOpacity="0.5" TintLuminosityOpacity="0.96" FallbackColor="#1C1C1C" />
                <LinearGradientBrush x:Key="HoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#15FFFFFF" Offset="0.0" />
                    <GradientStop Color="#05FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Base container with padding, NO border to avoid clipping -->
        <Border x:Name="_border" Padding="20,20,20,18" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="0">
            <Grid x:Name="_content">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="_headerGrid" Grid.Row="0" Margin="0,0,0,16">
                    <!-- Inline Renameable Title Container -->
                    <Grid x:Name="_titleContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="_title"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   PointerPressed="Title_PointerPressed"
                                   ToolTipService.ToolTip="Click or right-click to edit or rename">
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Edit app group" Click="EditGroup_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Edit app group (Parent)" Click="EditGroupParent_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE713;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Rename app group" Click="RenameGroup_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>
                        <TextBox x:Name="_titleEditBox"
                                 Visibility="Collapsed"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Padding="6,2"
                                 MinHeight="26"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 BorderThickness="0,0,0,2"
                                 CornerRadius="4,4,0,0"
                                 KeyDown="TitleEditBox_KeyDown"
                                 LostFocus="TitleEditBox_LostFocus"/>
                    </Grid>

                    <!-- Quick Edit Icon Button (Header Right, AppGroup style) -->
                    <Button x:Name="_headerEditBtn"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="26" Height="26"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Click="EditGroup_Click"
                            ToolTipService.ToolTip="Edit App Group">
                        <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>

                    <StackPanel x:Name="_editModeHeaderPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="_addAppBtn" ToolTipService.ToolTip="Add Application" Width="26" Height="26" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Specific file..." Click="AddSpecificFile_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Installed app..." Click="AddInstalledApp_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="_doneEditBtn" ToolTipService.ToolTip="Done Editing" Width="26" Height="26" Padding="0" Click="DoneEditBtn_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Style="{ThemeResource AccentButtonStyle}">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="_holder" Grid.Row="1" ManipulationMode="None">
                    <!-- Classic -->
                    <ScrollViewer x:Name="_classicSV" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" ManipulationMode="None">
                        <StackPanel x:Name="_classicPagesPanel" Orientation="Vertical" ManipulationMode="None">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0" />
                            </StackPanel.RenderTransform>
                        <popups:VariableGridView x:Name="_classicR" ItemClick="App_ItemClick" Margin="0" HorizontalAlignment="Center" SelectionMode="None" IsItemClickEnabled="True" Visibility="Collapsed" CanDragItems="True" AllowDrop="True"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                            ManipulationMode="None">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                    <Setter Property="VariableSizedWrapGrid.ColumnSpan" Value="{Binding ColSpan}"/>
                                    <Setter Property="VariableSizedWrapGrid.RowSpan" Value="{Binding RowSpan}"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                             <ControlTemplate TargetType="GridViewItem">
                                             <Grid x:Name="RootGrid" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                 <VisualStateManager.VisualStateGroups>
                                                     <VisualStateGroup x:Name="CommonStates">
                                                         <VisualState x:Name="Normal">
                                                             <VisualState.Setters>
                                                                 <Setter Target="TileCard.Background" Value="Transparent" />
                                                                 <Setter Target="TileCard.BorderBrush" Value="Transparent" />
                                                             </VisualState.Setters>
                                                         </VisualState>
                                                         <VisualState x:Name="PointerOver">
                                                             <VisualState.Setters>
                                                                 <Setter Target="TileCard.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                                 <Setter Target="TileCard.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                                                             </VisualState.Setters>
                                                         </VisualState>
                                                         <VisualState x:Name="Pressed">
                                                             <VisualState.Setters>
                                                                 <Setter Target="TileCard.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                                 <Setter Target="TileCard.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                                                             </VisualState.Setters>
                                                         </VisualState>
                                                     </VisualStateGroup>
                                                     <VisualStateGroup x:Name="FocusStates">
                                                         <VisualState x:Name="Focused">
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.040" />
                                                             </Storyboard>
                                                         </VisualState>
                                                         <VisualState x:Name="PointerFocused" />
                                                         <VisualState x:Name="Unfocused">
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.040" />
                                                             </Storyboard>
                                                         </VisualState>
                                                     </VisualStateGroup>
                                                 </VisualStateManager.VisualStateGroups>

                                                 <Border x:Name="TileCard"
                                                         CornerRadius="{ThemeResource ControlCornerRadius}"
                                                         BorderThickness="1"
                                                         BackgroundSizing="InnerBorderEdge"
                                                         Background="Transparent"
                                                         BorderBrush="Transparent"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         Margin="0">
                                                     <Border.BackgroundTransition>
                                                         <BrushTransition Duration="0:0:0.083" />
                                                     </Border.BackgroundTransition>
                                                 </Border>
                                                 <Border x:Name="FocusRing"
                                                         CornerRadius="{ThemeResource ControlCornerRadius}"
                                                         BorderThickness="2"
                                                         BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         Opacity="0"
                                                         Margin="-1"
                                                         IsHitTestVisible="False" />
                                                 <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Padding="0" />
                                             </Grid>
                                         </ControlTemplate>
                                         </Setter.Value>
                                     </Setter>
                                 </Style>
                             </GridView.ItemContainerStyle>
                             <GridView.ItemsPanel>
                                 <ItemsPanelTemplate>
                                     <VariableSizedWrapGrid x:Name="_classicWrapGrid" ItemWidth="80" ItemHeight="76" Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                 </ItemsPanelTemplate>
                             </GridView.ItemsPanel>
                             <GridView.ItemContainerTransitions>
                                 <TransitionCollection>
                                     <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24"/>
                                 </TransitionCollection>
                             </GridView.ItemContainerTransitions>
                             <GridView.ItemTemplate>
                                 <DataTemplate x:DataType="popups:AppEntryViewModel">
                                     <Grid Width="{x:Bind TileWidth, Mode=OneWay}" Height="{x:Bind TileHeight, Mode=OneWay}" CornerRadius="{ThemeResource ControlCornerRadius}" ToolTipService.Placement="Bottom" ToolTipService.ToolTip="{x:Bind Name}" Background="Transparent">
                                         <Grid.ContextFlyout>
                                             <MenuFlyout>
                                                 <MenuFlyoutItem Text="Open" Click="Open_Click" Tag="{x:Bind ExePath}">
                                                     <MenuFlyoutItem.Icon>
                                                         <FontIcon Glyph="&#xE8E5;" />
                                                     </MenuFlyoutItem.Icon>
                                                 </MenuFlyoutItem>
<MenuFlyoutItem Text="Run as Administrator" Click="RunAdmin_Click" Tag="{x:Bind ExePath}">
                                                     <MenuFlyoutItem.Icon>
                                                         <FontIcon Glyph="&#xE7EF;" />
                                                     </MenuFlyoutItem.Icon>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutItem Text="Launch Options..." Click="LaunchOptions_Click" Tag="{x:Bind}">
                                                     <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutSeparator />
                                                 <MenuFlyoutItem Text="Open file location" Click="OpenLoc_Click" Tag="{x:Bind ExePath}">
                                                     <MenuFlyoutItem.Icon>
                                                         <FontIcon Glyph="&#xE8DA;" />
                                                     </MenuFlyoutItem.Icon>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutSeparator />
                                                 <MenuFlyoutItem Text="Edit this Group" Click="EditGroup_Click">
                                                     <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutItem Text="Launch All" Click="LaunchAll_Click">
                                                     <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                                 </MenuFlyoutItem>
                                             </MenuFlyout>
                                         </Grid.ContextFlyout>

                                         <!-- 1x1 Standard layout -->
                                         <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind SmallTileVisibility, Mode=OneWay}">
                                             <Image Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" />
                                             <TextBlock FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" LineHeight="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Name}" MaxWidth="72" />
                                         </StackPanel>

                                         <!-- 2x1 Wide layout -->
                                         <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14,0" Visibility="{x:Bind WideTileVisibility, Mode=OneWay}">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="Auto" />
                                                 <ColumnDefinition Width="*" />
                                             </Grid.ColumnDefinitions>
                                             <Image Grid.Column="0" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" Margin="0,0,12,0" />
                                             <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                 <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" LineHeight="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Name}" />
                                             </StackPanel>
                                         </Grid>

                                         <!-- 1x2 Tall layout -->
                                         <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind TallTileVisibility, Mode=OneWay}">
                                             <Image Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" />
                                             <TextBlock FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3" LineHeight="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Name}" MaxWidth="72" />
                                         </StackPanel>

                                         <!-- 2x2 Large layout: hero centered presentation -->
                                         <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind LargeTileVisibility, Mode=OneWay}">
                                             <Image Width="54" Height="54" Stretch="Uniform" HorizontalAlignment="Center" Source="{x:Bind IconImage, Mode=OneWay}" />
                                             <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" LineHeight="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Name}" MaxWidth="140" />
                                         </StackPanel>

                                         <!-- Edit Mode Remove Badge (Top-Right) -->
                                          <!-- Badges (Notification Count & Admin Shield, Top-Right) -->
                                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Spacing="3">
                                              <!-- Live Notification Badge -->
                                              <Border MinWidth="16" Height="16" CornerRadius="8" Padding="4,0,4,0"
                                                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                      BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"
                                                      Visibility="{x:Bind NotificationBadgeVisibility, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind NotificationBadgeTooltip, Mode=OneWay}">
                                                  <TextBlock Text="{x:Bind NotificationBadgeText, Mode=OneWay}"
                                                             FontSize="10" FontWeight="SemiBold"
                                                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                              </Border>
                                              <!-- Admin Shield Badge (Windows UAC Shield) -->
                                              <Border Width="16" Height="16" CornerRadius="8"
                                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                      Visibility="{x:Bind AdminShieldVisibility, Mode=OneWay}"
                                                      ToolTipService.ToolTip="Always runs as administrator">
                                                  <FontIcon Glyph="&#xE7EF;" FontSize="9" Foreground="{x:Bind AdminShieldBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                              </Border>
                                          </StackPanel>
                                          <Button Click="RemoveAppBtn_Click" PointerEntered="RemoveAppBtn_PointerEntered" PointerExited="RemoveAppBtn_PointerExited" Tag="{x:Bind}" Visibility="{x:Bind EditModeVisibility, Mode=OneWay}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Padding="0" Margin="0,5,5,0"
                                                 CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlElevationBorderBrush}" ToolTipService.ToolTip="Remove from group">
                                             <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                         </Button>
                                         <!-- Edit Mode Size Cycle Badge (Bottom-Right) -->
                                         <Button Click="CycleSizeBtn_Click" Tag="{x:Bind}" Visibility="{x:Bind EditModeVisibility, Mode=OneWay}"
                                                 ManipulationMode="TranslateX,TranslateY"
                                                 ManipulationDelta="SizeBadge_ManipulationDelta"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" Padding="0" Margin="0,0,5,5"
                                                 CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlElevationBorderBrush}" ToolTipService.ToolTip="Resize: click to cycle (1x1, 2x1, 1x2, 2x2) or drag">
                                             <FontIcon Glyph="&#xE740;" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                         </Button>

                                         <!-- Running Indicator (Fluent 2 Taskbar Pill) -->
                                         <Border x:Name="RunningIndicator"
                                                 Width="16" Height="3" CornerRadius="1.5"
                                                 Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                 Margin="0,0,0,3"
                                                 Visibility="{x:Bind RunningBarVisibility, Mode=OneWay}" />
                                         <!-- Running Indicator Dot (Corner Dot) -->
                                         <Border x:Name="RunningDotIndicator" Width="6" Height="6" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="{x:Bind RunningDotVisibility, Mode=OneWay}" />
                                     </Grid>
                                 </DataTemplate>
                             </GridView.ItemTemplate>
                        </popups:VariableGridView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Compact Horizontal -->
                    <GridView x:Name="_compactR" ItemClick="App_ItemClick" Margin="0" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24"/>
                            </TransitionCollection>
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="MinWidth" Value="42"/>
                                <Setter Property="Width" Value="42"/>
                                <Setter Property="Height" Value="26"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <Grid x:Name="RootGrid" Background="Transparent" Width="42" Height="26">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Target="TileCard.Background" Value="Transparent" />
                                                                <Setter Target="TileCard.BorderBrush" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="TileCard.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                                <Setter Target="TileCard.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="TileCard.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                                <Setter Target="TileCard.BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="TileCard" CornerRadius="6" BorderThickness="1" BackgroundSizing="InnerBorderEdge" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,0,2,0">
                                                    <Border.BackgroundTransition>
                                                        <BrushTransition Duration="0:0:0.083" />
                                                    </Border.BackgroundTransition>
                                                </Border>
                                                <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="popups:AppEntryViewModel">
                                <Grid Width="42" Height="26" Margin="0" ToolTipService.Placement="Bottom" ToolTipService.ToolTip="{x:Bind Name}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open" Click="Open_Click" Tag="{x:Bind ExePath}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8E5;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
<MenuFlyoutItem Text="Run as Administrator" Click="RunAdmin_Click" Tag="{x:Bind ExePath}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7EF;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Launch Options..." Click="LaunchOptions_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Open file location" Click="OpenLoc_Click" Tag="{x:Bind ExePath}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8DA;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Edit this Group" Click="EditGroup_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
