                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Automatically tunes animation speeds for lower refresh rates (120Hz, 90Hz, 60Hz, 30Hz) so transitions remain swift and snappy compared to 240Hz"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AdaptiveRefreshRateToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="AdaptiveRefreshRateToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Animation Speed Multiplier (Experimental) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Animation Speed" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Manually adjust animation playback speed (faster reduces transition duration)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Slider x:Name="AnimationSpeedSlider" Width="140" Minimum="0.5" Maximum="2.5" StepFrequency="0.1"
                                        VerticalAlignment="Center" ValueChanged="AnimationSpeedSlider_ValueChanged"/>
                                <TextBlock x:Name="AnimationSpeedValueText" Text="1.0x" Width="36" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Disable Auto-Hide Support -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8D7;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Disable Auto-Hide Support" FontWeight="SemiBold"/>
                                <TextBlock Text="Prevents popups from closing automatically when losing window focus"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GlobalDisableAutoHideToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="GlobalDisableAutoHideToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Taskbar Gap Slider -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE740;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Taskbar Gap" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Distance between the taskbar and popup window (0 px docks flush against the taskbar)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Slider x:Name="GlobalTaskbarGapSlider" Grid.Column="2" Width="160" Minimum="0" Maximum="48" StepFrequency="1"
                                    VerticalAlignment="Center" ValueChanged="GlobalTaskbarGapSlider_ValueChanged"/>
                        </Grid>
                    </Border>

                    <!-- Disable Float -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8AB;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Disable Float" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Makes the bottom corners sharp and removes the gap between the taskbar and popup"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GlobalDisableFloatToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="GlobalDisableFloatToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Disable Rounded Corners -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C4;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Disable Rounded Corners" FontWeight="SemiBold"/>
                                <TextBlock Text="Makes popup corners sharp with square borders (classic Windows 10 style)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GlobalDisableRoundedCornersToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="GlobalDisableRoundedCornersToggle_Toggled"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ TASKBAR & SHORTCUTS ═══════════════════════════ -->
                <StackPanel Spacing="4" Margin="0,0,0,28">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="Taskbar &amp; Shortcuts" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Options for pinning groups to the Windows taskbar and system shortcuts."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Use TaskbandPin (Experimental) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEA86;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Use TaskbandPin" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Instead of manually pinning the apps from the desktop to taskbar, use the new direct app to taskbar TaskbandPin protocol"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PinToTaskbarIntentToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="PinToTaskbarIntentToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Instant Taskbar Pinning -->
                    <Border x:Name="InstantPinCard"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE718;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Instant Taskbar Pinning" FontWeight="SemiBold"/>
                                <TextBlock Text="Pin directly to the taskbar immediately when clicking Pin without requiring a confirmation prompt"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="InstantPinToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="InstantPinToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Pin to Start Menu -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE835;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Pin to Start Menu" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Add TaskTile to the Windows Start Menu on first launch"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PinStartToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="PinStartToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Suppress Explorer on Edit -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEC50;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Suppress File Explorer on Edit" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Prevent File Explorer from opening automatically when updating group icons or names"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="SuppressExplorerToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="SuppressExplorerToggle_Toggled"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ NICHES & CREATION ═══════════════════════════ -->
                <StackPanel Spacing="4" Margin="0,0,0,28">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="Niches &amp; Creation" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Customize terminology and the app group creation dialog experience."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Rename App Groups to Niches (Experimental) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8EC;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Rename App Groups to Niches" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Renames 'App Groups' throughout TaskTile to 'Niches', reflecting the original TaskTile prototype concept"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="UseNichesToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="UseNichesToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Show App Icons in Picker -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE91B;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Show app icons in picker" FontWeight="SemiBold"/>
                                <TextBlock Text="Display extracted high-resolution application icons in the group creation app list"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PickerIconsToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="PickerIconsToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Show File Paths in Picker -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Show file paths in picker" FontWeight="SemiBold"/>
                                <TextBlock Text="Display executable target file paths beneath app names in the group creation app list"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PickerPathsToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="PickerPathsToggle_Toggled"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ SYSTEM & STARTUP ═══════════════════════════ -->
                <StackPanel Spacing="4" Margin="0,0,0,28">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="System &amp; Startup" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Manage background services, system tray presence, and auto-start."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Run at Startup -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Run at Startup" FontWeight="SemiBold"/>
                                <TextBlock Text="Launch automatically in the background when Windows starts"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="StartupToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- System Tray Icon -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
