                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="System Tray Icon" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Close straight to the system tray notification area to keep background responsiveness"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="TrayToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="TrayToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Disable Installer Wizard -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
