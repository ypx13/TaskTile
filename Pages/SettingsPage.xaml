                                <TextBlock Text="Disable Installer Wizard" FontWeight="SemiBold"/>
                                <TextBlock Text="Skip the Alpha installer on every launch. Hold Shift at startup for a one-time skip"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="WizardToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="WizardToggle_Toggled"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ ABOUT & MAINTENANCE ═══════════════════════════ -->
                <StackPanel Spacing="4" Margin="0,0,0,24">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="About &amp; Maintenance" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Application information and data management."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Enable Backup & Restore System Toggle Card (Outside of Backup menu) -->
                    <Border Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEA35;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Enable Backup &amp; Restore System" FontWeight="SemiBold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Allow creating and importing TaskTile configuration archives"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="EnableBackupSystemToggle" IsOn="False"
                                          Toggled="EnableBackupSystemToggle_Toggled" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <!-- Backup & Restore Data Card -->
                    <Border Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEA35;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Backup &amp; Restore" FontWeight="SemiBold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Export or restore your app groups, configurations, and preferences to a backup archive"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="OpenBackupButton" Content="Open Backup" Style="{ThemeResource AccentButtonStyle}"
                                    Click="OpenBackup_Click" VerticalAlignment="Center" IsEnabled="False"/>
                        </Grid>
                    </Border>

                    <!-- Reset Application Data Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Reset Application Data" FontWeight="SemiBold"/>
                                <TextBlock Text="Permanently erase all app groups, shortcuts, and custom configurations"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Delete Data" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Click="DeleteData_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Footer with Author & Version -->
                    <Grid Margin="4,24,4,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="MadeByText" Text="baked with 💖 using WinUI 3 &amp; .NET 8 • TaskTile by ypx.13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Tapped="MadeBy_Tapped" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Star Wars Credits Overlay -->
        <Grid x:Name="StarWarsOverlay" Visibility="Collapsed" Background="Black">
            <MediaPlayerElement x:Name="StarWarsMusicPlayer" AutoPlay="False" AreTransportControlsEnabled="False" Visibility="Collapsed"/>
            <Canvas x:Name="CreditsCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock x:Name="CreditsText" TextAlignment="Center" Foreground="#FFE81F" FontFamily="Consolas" FontWeight="Bold" FontSize="24" Width="800" TextWrapping="Wrap" />
            </Canvas>
        </Grid>

        <!-- Debug Mode Overlay — slide-in panel with pull tab -->
        <!-- Outer container: pull tab + panel side by side -->
        <Grid x:Name="DebugOuterContainer" HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Pull Tab (always visible when panel is shown, click to toggle) -->
            <Border x:Name="DebugPullTab"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,1"
                    CornerRadius="8,0,0,8"
                    Padding="6,16"
                    Tapped="DebugPullTab_Tapped">
                <StackPanel Spacing="6">
                    <FontIcon Glyph="&#xE8B0;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <FontIcon x:Name="PullTabArrow" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Debug Panel -->
            <Border x:Name="DebugOverlay"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    CornerRadius="0"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="16"
                    MinWidth="340"
                    MaxWidth="380">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B0;" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <StackPanel>
                                <TextBlock Text="DTM Mode" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="TaskTile Developer &amp; Test Suite" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">

                            <!-- Important Debug & Version Info -->
                            <TextBlock Text="DEBUG &amp; VERSION INFO" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="DbgVersionTitle" Text="v0.7.5-beta" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock x:Name="DbgSemVerPill" Text="M:0 m:8 p:2" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <TextBlock x:Name="DbgGitBranchCommit" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DbgGitChanges" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DbgGitPush" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DbgGitWorkingTree" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Hotkey Status -->
                            <TextBlock Text="HOTKEY REGISTRATIONS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="DbgHotkeyHook" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="DbgHotkeyDetails" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- User Folder -->
                            <TextBlock Text="TASKTILE USER FOLDERS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="DbgOpenRoamingFolder_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}" Padding="6,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE838;" FontSize="12"/>
                                        <TextBlock Text="AppData (%Roaming%)" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="DbgOpenLocalFolder_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}" Padding="6,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                                        <TextBlock Text="Logs &amp; Cache (%Local%)" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- Logs Management -->
                            <TextBlock Text="LOG MANAGEMENT" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <TextBlock x:Name="DbgLogSummaryText" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="DbgExportLog_Click" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Padding="6,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="12"/>
                                        <TextBlock Text="Export Log" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="DbgDeleteLogs_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}" Padding="6,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        <TextBlock Text="Delete Logs" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="DbgLogActionStatusText" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- Test: Running Indicator & Fake Apps Running -->
                            <TextBlock Text="RUNNING APPS INDICATOR TEST" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <ToggleSwitch x:Name="DbgFakeRunningToggle" 
                                                  Header="Fake apps are running"
                                                  OffContent="Off (Real process detection)"
                                                  OnContent="On (Simulate all apps running)"
                                                  Toggled="DbgFakeRunningToggle_Toggled"/>
                                    <TextBlock Text="Simulates active running process status so all app tiles glow with running dots/indicators." FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- Test: Taskbar JumpList -->
                            <TextBlock Text="TASKBAR JUMPLIST TEST" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Add test jumplist items (Calc, Notepad, Test tasks) to an app group taskbar shortcut." FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="DbgJumpListGroupCombo" HorizontalAlignment="Stretch" PlaceholderText="Select app group for jumplist"/>
                                    <Button x:Name="DbgAddTestJumpListBtn" Click="DbgAddTestJumpList_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                            <TextBlock Text="Add Test JumpList to Shortcut" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="DbgJumpListStatusText" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- Badge Tester -->
                            <TextBlock Text="NOTIFICATION BADGE TESTER" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <ComboBox x:Name="DbgBadgeAppCombo" HorizontalAlignment="Stretch" PlaceholderText="Pick a test app"
                                      SelectionChanged="DbgBadgeAppCombo_SelectionChanged">
                                <ComboBoxItem Content="WhatsApp" Tag="WhatsApp"/>
                                <ComboBoxItem Content="Discord" Tag="Discord"/>
                                <ComboBoxItem Content="Telegram" Tag="Telegram"/>
                                <ComboBoxItem Content="Outlook" Tag="Outlook"/>
                                <ComboBoxItem Content="Mail" Tag="Mail"/>
                                <ComboBoxItem Content="Slack" Tag="Slack"/>
                            </ComboBox>

                            <!-- Count slider -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DbgBadgeCountSlider" Grid.Column="0"
                                        Minimum="0" Maximum="99" Value="0"
                                        StepFrequency="1" SnapsTo="StepValues"
                                        ValueChanged="DbgBadgeCountSlider_ValueChanged"
                                        IsEnabled="False"/>
                                <TextBlock x:Name="DbgBadgeCountText" Grid.Column="1"
                                           Text="0" FontFamily="Consolas" FontSize="14"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           MinWidth="28" TextAlignment="Right"/>
                            </Grid>

                            <TextBlock x:Name="DbgBadgeStatusText"
                                       FontSize="10" FontFamily="Consolas"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Button Click="DbgBadgeClearAll_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                    <TextBlock Text="Clear All Mock Badges"/>
                                </StackPanel>
                            </Button>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- Bar Detection & Actions -->
                            <TextBlock Text="BAR DETECTION &amp; UI DEMOS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <TextBlock x:Name="DbgDetected" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas"/>
                            <TextBlock x:Name="DbgDetectionResult" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            <Button Click="DbgTriggerDemo_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12"/>
                                    <TextBlock Text="Trigger Alert Demo"/>
                                </StackPanel>
                            </Button>
                            <Button Click="DbgFrostedGlass_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81D;" FontSize="12"/>
                                    <TextBlock Text="Test Frosted Glass"/>
                                </StackPanel>
                            </Button>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- System & App Diagnostics -->
                            <TextBlock Text="SYSTEM DIAGNOSTICS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="150"/>
                            <TextBlock x:Name="DbgOS"         FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas"/>
                            <TextBlock x:Name="DbgMachine"    FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas"/>
                            <TextBlock x:Name="DbgUser"       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas"/>
                            <TextBlock x:Name="DbgUptime"     FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas"/>
                            <TextBlock x:Name="DbgAppStats"   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                        <Button x:Name="DbgCopyBtn" Content="Copy Diagnostic Report" Click="DbgCopy_Click" HorizontalAlignment="Stretch" Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button x:Name="DbgDisableBtn" Content="Disable Debug Mode" Click="DbgDisable_Click" HorizontalAlignment="Stretch" Background="{ThemeResource SystemFillColorCriticalBrush}" BorderBrush="Transparent" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bubble / Particle Effect Overlay -->
        <Canvas x:Name="EffectCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Page>
