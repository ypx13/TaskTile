<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskTile.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Dark Theme (Default) -->
                    <LinearGradientBrush x:Key="AppGroupPreviewBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#E62C2C2C" Offset="0.0"/>
                        <GradientStop Color="#E62C2C2C" Offset="0.40"/>
                        <GradientStop Color="#882C2C2C" Offset="0.70"/>
                        <GradientStop Color="#252C2C2C" Offset="0.90"/>
                        <GradientStop Color="#002C2C2C" Offset="1.0"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppGroupPreviewBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#28FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#28FFFFFF" Offset="0.40"/>
                        <GradientStop Color="#14FFFFFF" Offset="0.70"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.90"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="AppGroupPreviewBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#E62C2C2C" Offset="0.0"/>
                        <GradientStop Color="#E62C2C2C" Offset="0.40"/>
                        <GradientStop Color="#882C2C2C" Offset="0.70"/>
                        <GradientStop Color="#252C2C2C" Offset="0.90"/>
                        <GradientStop Color="#002C2C2C" Offset="1.0"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppGroupPreviewBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#28FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#28FFFFFF" Offset="0.40"/>
                        <GradientStop Color="#14FFFFFF" Offset="0.70"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.90"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="AppGroupPreviewBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#F0F6F6F6" Offset="0.0"/>
                        <GradientStop Color="#F0F6F6F6" Offset="0.40"/>
                        <GradientStop Color="#90F6F6F6" Offset="0.70"/>
                        <GradientStop Color="#25F6F6F6" Offset="0.90"/>
                        <GradientStop Color="#00F6F6F6" Offset="1.0"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AppGroupPreviewBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#20000000" Offset="0.0"/>
                        <GradientStop Color="#20000000" Offset="0.40"/>
                        <GradientStop Color="#10000000" Offset="0.70"/>
                        <GradientStop Color="#03000000" Offset="0.90"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!-- Top margin prevents the scrollbar and content from going under the title bar / window buttons -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,48,0,0" Padding="0,0,16,0">
            <!-- Centered content column, max width 620 -->
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="620" Margin="32,0,32,32">
                <TextBlock Text="Settings" Style="{ThemeResource TitleLargeTextBlockStyle}" Margin="0,0,0,8"/>

                <InfoBar x:Name="GlobalConfigInfoBar" IsOpen="True" Severity="Informational" Title="Global Configuration"
                         Message="These settings apply across TaskTile, its launchers, and desktop integration."
                         IsClosable="False" Margin="0,0,0,20" />

                <!-- ═══════════════════════════ PERSONALIZATION ═══════════════════════════ -->
                <StackPanel Spacing="4" Margin="0,0,0,28">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="Personalization" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Customize the color palette, material backdrops, and card layouts."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- ypx.mixUI (Preserved collapsed for code-behind bindings) -->
                    <Border Visibility="Collapsed">
                        <ToggleSwitch x:Name="MixUIToggle" Toggled="MixUIToggle_Toggled" />
                    </Border>

                    <!-- App Theme -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="App Theme" FontWeight="SemiBold"/>
                                <TextBlock Text="Select light, dark, or system color theme"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="160" VerticalAlignment="Center"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="System default"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Window Backdrop -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Window Backdrop" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose the transparency material effect (Mica or Acrylic)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="BackdropCombo" Grid.Column="2" Width="160" VerticalAlignment="Center"
                                      SelectionChanged="BackdropCombo_SelectionChanged">
                                <ComboBoxItem Content="Acrylic"/>
                                <ComboBoxItem Content="Mica"/>
                                <ComboBoxItem Content="Mica Alt"/>
                                <ComboBoxItem Content="None"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Group Card Style (Secret) -->
                    <Border x:Name="GroupCardStyleCard"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE80A;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Card Style" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Choose between Classic horizontal cards, Detailed square cards, or one-line Compact rows"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="GroupCardStyleCombo" Grid.Column="2" Width="160" VerticalAlignment="Center"
                                      SelectionChanged="GroupCardStyleCombo_SelectionChanged">
                                <ComboBoxItem Content="Classic"/>
                                <ComboBoxItem Content="Detailed"/>
                                <ComboBoxItem Content="Compact"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Title Alignment (Standalone Slider Box) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE8E3;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Title Alignment" FontWeight="SemiBold"/>
                                <TextBlock Text="Set the alignment of the app group title (Left, Center, Right)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Slider x:Name="TitleAlignmentSlider" Grid.Column="2" Width="200" VerticalAlignment="Center" 
                                    Minimum="0" Maximum="2" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" 
                                    ValueChanged="TitleAlignmentSlider_ValueChanged" />
                        </Grid>
                    </Border>

                    <!-- Slide-in container: Height animates 0 → 48 (compact preview, barely moves sections below) -->
                    <Grid x:Name="TitlePreviewContainer" Height="0" Visibility="Collapsed">
                        <!-- Preview: represents the top 1/3 of an app group popup with bottom fade -->
                        <Grid x:Name="TitlePreviewHost" HorizontalAlignment="Center" Width="200" Height="46" Margin="0,4,0,0"
                              Opacity="0" VerticalAlignment="Top">
                            <!-- Popup simulated top section: 1.5px stroke, popup-toned border, rounded top, gradient fill & border that fade to transparent -->
                            <Border x:Name="SimulatedAppGroup"
                                    CornerRadius="12,12,0,0"
                                    Background="{ThemeResource AppGroupPreviewBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppGroupPreviewBorderBrush}"
                                    BorderThickness="1.5,1.5,1.5,0">
                                <Grid x:Name="PreviewTitleHost" Margin="14,8,14,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="PreviewTitleText"
                                               Text="Sample"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="PreviewTitleTransform" X="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>


                <!-- ═══════════════════════════ POPUPS & LAUNCHING ═══════════════════════════ -->
                <StackPanel Spacing="4" Margin="0,0,0,28">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="Popups &amp; Launching" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Control how popup windows position, animate, and behave on screen."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- App Group Launch Side -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8AD;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Launch Screen Edge" FontWeight="SemiBold"/>
                                <TextBlock Text="Which screen edge or monitor position app groups pop up from"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="LaunchSideCombo" Grid.Column="2" Width="160" VerticalAlignment="Center"
                                      SelectionChanged="LaunchSideCombo_SelectionChanged">
                                <ComboBoxItem Content="Top"/>
                                <ComboBoxItem Content="Bottom"/>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Left"/>
                                        <TextBlock Text="🧪" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Right"/>
                                        <TextBlock Text="🧪" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Content="Center"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Global Make Main Focus (conditional on Center) -->
                    <Border x:Name="GlobalMakeMainFocusContainer" Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE740;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Make Main Focus" FontWeight="SemiBold"/>
                                <TextBlock Text="Focus the pop-up and dim desktop background when launched at center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GlobalMakeMainFocusToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="GlobalMakeMainFocusToggle_Toggled"/>
                        </Grid>
                    </Border>
                    <!-- Running App Indicator Style -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C5;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Running App Indicator" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose how currently active or running apps are highlighted in app groups"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="RunningIndicatorStyleCombo" Grid.Column="2" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="RunningIndicatorStyleCombo_SelectionChanged">
                                <ComboBoxItem Content="Taskbar Bar (Default)"/>
                                <ComboBoxItem Content="Corner Dot"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Show Administrator Shield Badge Card (Experimental, On by default) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7EF;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Administrator Shield Badge" FontWeight="SemiBold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Display a Windows administrator shield badge in the corner of apps set to always run as admin"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="ShowAdminShieldToggle" IsOn="True"
                                          Toggled="ShowAdminShieldToggle_Toggled" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <!-- Administrator Shield Badge Color Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Administrator Shield Badge Color" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose between classic Windows gold or neutral monochrome for the admin shield badge"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="AdminShieldColorCombo" Grid.Column="2" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="AdminShieldColorCombo_SelectionChanged">
                                <ComboBoxItem Content="Gold (Windows UAC)"/>
                                <ComboBoxItem Content="Neutral"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- App Notification Badges Card (Experimental, On by default) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="App Notification Badges" FontWeight="SemiBold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Display live notification count badges on apps inside app groups (e.g. WhatsApp, Discord, Mail)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="ShowNotificationBadgesToggle" IsOn="True"
                                          Toggled="ShowNotificationBadgesToggle_Toggled" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <!-- Preload Pop-ups in Background -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEC4A;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Preload Pop-ups in Background" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Keep the pop-up window alive in memory for instant 0ms launch times"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="BackgroundPopupToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="BackgroundPopupToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Grayscale Taskbar Icon -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Grayscale Taskbar Icon" FontWeight="SemiBold"/>
                                <TextBlock Text="Show the group icon in grayscale on the taskbar while the popup is open"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GrayscaleTaskbarIconToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="GrayscaleTaskbarIconToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Apply Global Config to Popups -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Apply Global Config to Popups" FontWeight="SemiBold"/>
                                <TextBlock Text="When enabled, popups inherit the main app's theme and backdrop settings"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PopupsConfigToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="PopupsConfigToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Disable Entrance Animation -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8B1;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Disable Entrance Animation" FontWeight="SemiBold"/>
                                <TextBlock Text="Disables sliding and fading animations for popups"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GlobalDisableAnimationToggle" Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="GlobalDisableAnimationToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- App Entrance Animation -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE93C;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="App Entrance Animation" FontWeight="SemiBold"/>
