<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskTile.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTile.Pages">

    <Grid Background="Transparent">
        <!-- Top margin prevents the scrollbar and content from colliding with the title bar -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,48,0,0" Padding="0,0,16,0">
            <!-- Centered content column, max width 620 to match SettingsPage -->
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="620" Margin="32,0,32,32" Spacing="20">

                <!-- Header with Back Button & Experimental Badge -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton"
                            Width="36" Height="36" Padding="0"
                            VerticalAlignment="Center"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Click="BackButton_Click"
                            ToolTipService.ToolTip="Back to Settings"
                            Margin="0,0,14,0">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Backup &amp; Restore" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Experimental" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Export your configurations, custom CLI options, and app groups into a portable archive"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Feedback InfoBar (at the top so user sees status immediately) -->
                <InfoBar x:Name="FeedbackInfoBar" IsOpen="False" Severity="Success" Margin="0,0,0,4"/>

                <!-- old code here -->
                <StackPanel Spacing="4" Margin="0,0,0,4">
                    <StackPanel Spacing="2" Margin="0,0,0,4">
                        <TextBlock Text="Restore" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Import previous configurations and app groups from a backup archive."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Restore from Backup" FontWeight="SemiBold"/>
                                <TextBlock Text="Import previous configurations and app groups from a .zip backup archive"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="RestoreBackupButton" Content="Restore..." Click="RestoreButton_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- new code here i think -->
                <StackPanel x:Name="BackupControlsPanel" Spacing="10">
                    <StackPanel Spacing="2" Margin="0,0,0,4">
                        <TextBlock Text="Create Backup" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Customize components to bundle into your portable backup."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- What to Include Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <StackPanel Spacing="12">
                            <TextBlock Text="What to Include" FontWeight="SemiBold" FontSize="14"/>

                            <!-- Settings -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Application Settings &amp; Personalization" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Includes theme, backdrops, taskbar offsets, launch positions, and animations"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="BackupSettingsCheck" IsChecked="True" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <MenuFlyoutSeparator Margin="0,-2,0,-2"/>

                            <!-- Groups -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="App Groups &amp; Structure" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Includes app entries, tiles, order, column layout, and pinning metadata"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="BackupGroupsCheck" IsChecked="True" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          Checked="BackupGroupsCheck_Checked" Unchecked="BackupGroupsCheck_Unchecked"/>
                            </Grid>

                            <MenuFlyoutSeparator Margin="0,-2,0,-2"/>

                            <!-- Launch Options -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Command-Line Arguments &amp; Admin Privileges" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Includes custom startup arguments, launch flags, and run-as-admin flags for all apps"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="BackupLaunchOptionsCheck" IsChecked="True" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <MenuFlyoutSeparator Margin="0,-2,0,-2"/>

                            <!-- Icons -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Custom Icons &amp; Media Assets" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="Bundles custom imported icons, group images, and visual overrides into the archive"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="BackupIconsCheck" IsChecked="True" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- App Groups Selection -->
                    <Border x:Name="GroupsSelectorCard"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="App Groups" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Select individual app groups to include in the backup archive"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="SelectAllGroupsCheck"
                                          Content="Select All" IsChecked="True"
                                          MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="SelectAllGroupsCheck_Click"/>
                            </Grid>

                            <ListView x:Name="GroupsListView" SelectionMode="Multiple" MaxHeight="200"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:GroupBackupItem">
                                        <Grid Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind AppsCountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Destination -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xED25;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Backup Destination" FontWeight="SemiBold"/>
                                <TextBox x:Name="DestinationPathBox" IsReadOnly="True" FontSize="12" Height="32"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="ChangeDestButton" Content="Browse..." Click="ChangeDestButton_Click" VerticalAlignment="Bottom" Height="32"/>
                        </Grid>
                    </Border>

                    <!-- Create Backup Button Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Create Backup Archive" FontWeight="SemiBold"/>
                                <TextBlock Text="Bundle all selected settings and groups into a portable .zip archive"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="CreateBackupButton"
                                    Content="Create Backup Now"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Height="36" Padding="20,0"
                                    VerticalAlignment="Center"
                                    Click="CreateBackupButton_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
