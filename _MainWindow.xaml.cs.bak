using Microsoft.UI.Composition;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Microsoft.UI.Xaml.Media;
using Microsoft.UI.Xaml.Media.Animation;
// using TaskTile.Pages;
// using TaskTile.Services;
using Microsoft.UI.Windowing;
using Microsoft.UI.Xaml.Hosting;
using Microsoft.UI.Xaml.Input;
using System.Numerics;
using Windows.Graphics;
using Microsoft.UI.Composition.SystemBackdrops;
using Microsoft.UI;

namespace TaskTile;

public sealed partial class MainWindow : Window
{
    private Compositor? _compositor;
    private Visual? _homeFillVisual;
    private Visual? _homeRootVisual;
    private Visual? _groupsVisual;
    private InsetClip? _homeClip;

    public MainWindow()
    {
        this.InitializeComponent();

        this.RootGrid.Loaded += (s, e) => {
            _compositor = Microsoft.UI.Xaml.Media.CompositionTarget.GetCompositorForCurrentThread();
            
            // Setup Home Icon Reveal
            _homeFillVisual = ElementCompositionPreview.GetElementVisual(HomeFillIcon);
            _homeRootVisual = ElementCompositionPreview.GetElementVisual(HomeIconRoot);
            _homeClip = _compositor.CreateInsetClip();
            _homeClip.BottomInset = 24.0f; // Hidden initially
            _homeFillVisual.Clip = _homeClip;
            
            _homeRootVisual.CenterPoint = new Vector3(12, 12, 0);

            // Setup Groups Icon
            _groupsVisual = ElementCompositionPreview.GetElementVisual(GroupsIcon);
            _groupsVisual.CenterPoint = new Vector3(12, 12, 0); // FontIcons are 24x24 usually if not specified
        };

        var hwnd = WinRT.Interop.WindowNative.GetWindowHandle(this);
        var iconPath = System.IO.Path.Combine(System.AppDomain.CurrentDomain.BaseDirectory, "Assets", "newicon.png");
        if (System.IO.File.Exists(iconPath))
        {
            try
            {
                var bmp = new System.Drawing.Bitmap(iconPath);
                var iconId = Microsoft.UI.Win32Interop.GetIconIdFromIcon(bmp.GetHicon());
                Microsoft.UI.Windowing.AppWindow.GetFromWindowId(Microsoft.UI.Win32Interop.GetWindowIdFromWindow(hwnd)).SetIcon(iconId);
            } catch { }
        }

        SettingsService.Load();
        ApplySettings();

        SettingsService.SettingsChanged += ApplySettings;

        SetupWindow();

        // default to Home
        NavView.SelectedItem = NavView.MenuItems[0];
        ContentFrame.Navigate(typeof(HomePage));
        
        App.MainWindowInstance = this;
        this.AppWindow.Closing += AppWindow_Closing;
    }

    private void myButton_Click(object sender, RoutedEventArgs e)
    {
    }

    private void AppWindow_Closing(Microsoft.UI.Windowing.AppWindow sender, Microsoft.UI.Windowing.AppWindowClosingEventArgs args)
    {
        if (SettingsService.Current.EnableTrayIcon)
        {
            args.Cancel = true;
            this.AppWindow.Hide();
        }
        else
        {
            App.MainWindowInstance = null;
        }
    }

    private void SetupWindow()
    {
        this.ExtendsContentIntoTitleBar = true;
        var appWindow = this.AppWindow;
        if (appWindow.TitleBar != null)
        {
            appWindow.TitleBar.PreferredHeightOption = TitleBarHeightOption.Tall;
        }
        appWindow.Resize(new Windows.Graphics.SizeInt32(960, 660));
        Center();
    }

    private void Center()
    {
        var displayArea = DisplayArea.GetFromWindowId(AppWindow.Id, DisplayAreaFallback.Primary);
        var workArea = displayArea.WorkArea;
        AppWindow.Move(new Windows.Graphics.PointInt32(
            (workArea.Width - AppWindow.Size.Width) / 2,
            (workArea.Height - AppWindow.Size.Height) / 2
        ));
    }

    public void ApplySettings()
    {
        var s = SettingsService.Current;

        // Theme Hook - we only apply RequestedTheme if differing from app startup theme
        if (this.Content is FrameworkElement root)
        {
            if (s.Theme == 1) root.RequestedTheme = ElementTheme.Light;
            else if (s.Theme == 2) root.RequestedTheme = ElementTheme.Dark;
            else root.RequestedTheme = ElementTheme.Default;
        }

        // Backdrop Hook
        if (s.BackdropStyle == 1)
        {
            this.SystemBackdrop = new MicaBackdrop() { Kind = Microsoft.UI.Composition.SystemBackdrops.MicaKind.BaseAlt };
        }
        else // Acrylic 
        {
            this.SystemBackdrop = new AlwaysActiveAcrylicBackdrop();
        }
    }

    public void NavigateTo(System.Type pageType)
    {
        ContentFrame.Navigate(pageType);
        
        foreach (var item in NavView.MenuItems)
        {
            if (item is NavigationViewItem navItem && navItem.Tag?.ToString() == pageType.Name.Replace("Page", ""))
            {
                NavView.SelectedItem = navItem;
                break;
            }
        }
    }

    private void NavView_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)
    {
        if (args.SelectedItemContainer is NavigationViewItem item)
        {
            var tag = item.Tag?.ToString();
            var pageType = tag switch
            {
                "Home" => typeof(HomePage),
                "Groups" => typeof(GroupsPage),
                "Settings" => typeof(SettingsPage),
                _ => typeof(HomePage)
            };
            ContentFrame.Navigate(pageType);
        }
    }

    private void Item_PointerEntered(object sender, Microsoft.UI.Xaml.Input.PointerRoutedEventArgs e)
    {
        if (sender is NavigationViewItem item && _compositor != null)
        {
            var tag = item.Tag?.ToString();
            if (tag == "Home") 
            {
                AnimateHome(true);
            }
            else if (tag == "Groups" && _groupsVisual != null) 
            {
                AnimateGroups(true);
            }
        }
    }

    private void Item_PointerExited(object sender, Microsoft.UI.Xaml.Input.PointerRoutedEventArgs e)
    {
        if (sender is NavigationViewItem item && _compositor != null)
        {
            var tag = item.Tag?.ToString();
            if (tag == "Home") 
            {
                AnimateHome(false);
            }
            else if (tag == "Groups" && _groupsVisual != null) 
            {
                AnimateGroups(false);
            }
        }
    }

    private void AnimateHome(bool enter)
    {
        if (_compositor == null || _homeClip == null || _homeRootVisual == null) return;

        // Clip animation (Water Fill)
        var clipAnim = _compositor.CreateScalarKeyFrameAnimation();
        clipAnim.InsertKeyFrame(1.0f, enter ? 0.0f : 24.0f);
        clipAnim.Duration = System.TimeSpan.FromSeconds(0.4);
        _homeClip.StartAnimation("BottomInset", clipAnim);

        // Scale animation (Squish and Bounce)
        if (enter)
        {
            var spring = _compositor.CreateSpringVector3Animation();
            spring.Target = "Scale";
            spring.FinalValue = new Vector3(1.0f, 1.0f, 1.0f);
            spring.DampingRatio = 0.5f;
            spring.Period = System.TimeSpan.FromSeconds(0.1);
            
            // Snap to squashed state first
            _homeRootVisual.Scale = new Vector3(1.3f, 0.7f, 1.0f);
            _homeRootVisual.StartAnimation("Scale", spring);
        }
    }

    private void AnimateGroups(bool enter)
    {
        if (_compositor == null || _groupsVisual == null) return;

        var spring = _compositor.CreateSpringVector3Animation();
        spring.Target = "Scale";
        spring.DampingRatio = 0.6f;
        spring.Period = System.TimeSpan.FromSeconds(0.15);

        if (enter)
        {
            spring.FinalValue = new Vector3(1.0f, 1.0f, 1.0f);
            _groupsVisual.Scale = new Vector3(0.6f, 1.3f, 1.0f); // Side-to-side stretch
            _groupsVisual.StartAnimation("Scale", spring);
        }
        else
        {
            spring.FinalValue = new Vector3(1.0f, 1.0f, 1.0f);
            _groupsVisual.StartAnimation("Scale", spring);
        }
    }
}

public class AlwaysActiveAcrylicBackdrop : Microsoft.UI.Xaml.Media.SystemBackdrop
{
    Microsoft.UI.Composition.SystemBackdrops.DesktopAcrylicController? _controller;
    Microsoft.UI.Composition.SystemBackdrops.SystemBackdropConfiguration? _config;

    protected override void OnTargetConnected(Microsoft.UI.Composition.ICompositionSupportsSystemBackdrop connectedTarget, Microsoft.UI.Xaml.XamlRoot xamlRoot)
    {
        base.OnTargetConnected(connectedTarget, xamlRoot);
        _controller = new Microsoft.UI.Composition.SystemBackdrops.DesktopAcrylicController();
        _controller.TintColor = Microsoft.UI.Colors.Transparent;
        _controller.TintOpacity = 0.0f;
        _controller.FallbackColor = Microsoft.UI.Colors.Transparent;
        _config = new Microsoft.UI.Composition.SystemBackdrops.SystemBackdropConfiguration() { IsInputActive = true };
        _controller.AddSystemBackdropTarget(connectedTarget);
        _controller.SetSystemBackdropConfiguration(_config);
    }

    protected override void OnTargetDisconnected(Microsoft.UI.Composition.ICompositionSupportsSystemBackdrop disconnectedTarget)
    {
        base.OnTargetDisconnected(disconnectedTarget);
        _controller?.RemoveSystemBackdropTarget(disconnectedTarget);
        _controller?.Dispose();
        _controller = null;
    }
}
