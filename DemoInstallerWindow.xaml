<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TaskTile.DemoInstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TaskTile ALPHA Installer">

    <Grid Background="Transparent" Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Caption Buttons -->
        <Border Grid.Row="0" x:Name="AppTitleBar" Height="40" Background="Transparent">
            <Grid>
                <!-- Custom left-aligned Title + Green ALPHA badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="6">
                    <TextBlock Text="TaskTile" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="#FF4CAF50" CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                        <TextBlock Text="ALPHA" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Installer" Foreground="White" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Right-aligned Caption buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="46" Height="40" Background="Transparent" BorderThickness="0" Foreground="White" CornerRadius="0" Click="MinimizeButton_Click">
                        <Button.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="14" Width="46" Height="40" Background="Transparent" BorderThickness="0" Foreground="White" CornerRadius="0,8,0,0" Click="CloseButton_Click">
                        <Button.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F1707A"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Phase 1: Introduction -->
        <Grid x:Name="Phase1Grid" Grid.Row="1" Visibility="Visible">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" Margin="40,0">
                <TextBlock Text="🎩🪄" FontSize="84" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TipTextBlock" Text="Welcome to TaskTile wizard!&#x0a;Press next to continue" Foreground="White" FontSize="20" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Phase 2: Location -->
        <Grid x:Name="Phase2Grid" Grid.Row="1" Visibility="Collapsed">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="60,0" Spacing="20">
                <TextBlock Text="Choose Install Location" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Setup will install TaskTile in the following folder." Foreground="White" FontSize="14" Opacity="0.8"/>
                
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LocationTextBox" Text="C:\Program Files\TaskTile" IsReadOnly="True" Height="36" />
                    <Button Grid.Column="1" Content="Browse..." Height="36" Margin="10,0,0,0" Style="{StaticResource DefaultButtonStyle}" />
                </Grid>
                
            </StackPanel>
        </Grid>

        <!-- Phase 3: Install & Done -->
        <Grid x:Name="Phase3Grid" Grid.Row="1" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="60,0" Spacing="20">
                <!-- WebView2 renders the transparent WebM correctly (Chromium handles VP9 alpha) -->
                <WebView2 x:Name="InstallerWebView"
                    HorizontalAlignment="Center"
                    Width="140" Height="140"
                    Margin="0,0,0,10"
                    DefaultBackgroundColor="Transparent"/>
                
                <TextBlock x:Name="Phase3Title" Text="Installing..." Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <StackPanel Spacing="5">
                    <TextBlock x:Name="PercentTextBlock" Text="0%" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                    <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" Background="#333333" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Background="#11FFFFFF" Height="60">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Spacing="10">
                <Button x:Name="NextButton" Content="Next" MinWidth="100" Padding="12,5" Style="{StaticResource AccentButtonStyle}" Click="NextButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="100" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
